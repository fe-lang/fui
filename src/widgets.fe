//! Widgets: what views draw with.
//!
//! ```fe
//! fn view(_ area: Rect, _ names: MemSlice<MemBuffer>, _ files: mut ListState) uses (frame: mut Frame) {
//!     let (body, bar) = Block::bordered().render_titled(area, "Files").columns((Fill(1), Length(1)))
//!     List::new().highlight_symbol("> ").render(body, names, mut files)
//!     Scrollbar::vertical().render_for(bar, files.scroll())
//! }
//!
//! fn update(_ files: mut ListState, _ event: Event) -> bool {
//!     match event {
//!         Event::Key(key) => files.handle_key(key),
//!         Event::Mouse(mouse) => files.handle_mouse(mouse).is_some(),
//!         _ => false,
//!     }
//! }
//! ```
//!
//! Every widget has the same shape:
//!
//! - Configuration by value. A widget is a small `Copy` value, built by
//!   methods that each return a changed copy:
//!   `Block::bordered().rounded().border_style(style)`.
//! - Data by view. What a widget shows is a parameter of its render, a view
//!   of the caller's data, so nothing is copied: the items of a list, the
//!   rows of a table, a title.
//! - State by `mut`. What outlives a frame, such as a selection, a scroll
//!   position or a cursor, is a state value in the program's model, passed
//!   to the render as `mut`. The render records what it laid out in it, and
//!   the state's `handle_key` and `handle_mouse` use that between frames.
//! - Drawing by effect. A render draws through `uses (frame: mut Frame)`,
//!   only inside the area it is given: a tiny or empty area draws what
//!   fits, or nothing, and never panics. Styles come from the frame's
//!   theme, by role, and a style set on a widget applies over the theme's.
//! - Closures for custom rows. `List::render_with` and `Table::render_with`
//!   draw each row or cell by calling a closure, with the frame clipped to
//!   it, so a row can hold any drawing.
//!
//! The widgets are `Block` (borders and titles), `Paragraph` (text,
//! wrapped or cut), `List` and `ListState`, `Table` and `TableState`,
//! `Tabs` and `TabsState`, `TextInput` and `TextInputState`, `Gauge` and
//! `LineGauge` (progress), `Sparkline` (a bar chart of recent values),
//! `Spinner` (work in progress), `Scrollbar`, and `clear` and `popup` (for
//! what is drawn over other widgets). `ScrollState` is the scroll position
//! that lists, tables and paragraphs share.
//!
//! The states use one set of names: `select` and `selected`,
//! `select_next` and `select_previous`, `handle_key`, which returns whether
//! the key is one the widget takes, `handle_mouse`, which returns what a
//! left click selected, and `area`, the area of the last render.
use std::io::Display
use ingot::frame::Frame
use ingot::geom::Rect

pub use block::{Block, BorderSymbols, BorderType, Borders, Padding}
pub use clear::{clear, popup}
pub use gauge::{Gauge, LineGauge}
pub use list::{List, ListRow, ListState}
pub use paragraph::Paragraph
pub use scroll::{ScrollState, WHEEL_ROWS}
pub use scrollbar::{Orientation, Scrollbar}
pub use sparkline::Sparkline
pub use spinner::Spinner
pub use table::{Column, MAX_COLUMNS, Table, TableCell, TableHit, TableRow, TableState}
pub use tabs::{MAX_TABS, Tabs, TabsState}
pub use text_input::{TextInput, TextInputState, TextLimit}

pub use ingot::text::Alignment

// Draws the `Display` text of `text` on the top row of `area`, placed by
// `alignment` and cut to the area, with an ellipsis if `ellipsis`; see
// `Frame::print_line`. The cells keep their styles.
pub(ingot) fn print_cut<T: Display>(
    _ area: Rect,
    _ text: T,
    _ alignment: Alignment,
    ellipsis: bool,
) -> u16
uses (frame: mut Frame)
{
    var bytes = frame.take_scratch()
    text.fmt(mut bytes)
    let written = frame.print_line_cut(area, bytes.span(), alignment, ellipsis)
    frame.restore_scratch(bytes)
    written
}

// `value` as a `u16`, or 65535 if it is larger.
pub(ingot) fn clamp_u16(_ value: usize) -> u16 {
    if value > 65535 {
        65535
    } else {
        value.downcast_truncate()
    }
}

#[test]
fn alignments_place_content_in_the_room_left() {
    assert(Alignment::Left.offset(width: 3, available: 10) == 0)
    assert(Alignment::Center.offset(width: 3, available: 10) == 3)
    assert(Alignment::Right.offset(width: 3, available: 10) == 7)
    assert(Alignment::Center.offset(width: 12, available: 10) == 0)
    assert(Alignment::Right.offset(width: 10, available: 10) == 0)
    assert(Alignment::Center != Alignment::Right)
}

#[test]
fn values_clamp_to_u16() {
    assert(
        clamp_u16(70000) == 65535 && clamp_u16(65535) == 65535 && clamp_u16(7) == 7,
    )
}
