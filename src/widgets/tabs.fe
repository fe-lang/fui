//! A row of tabs, one of them selected.
use core::ops::{Index, Len}
use std::abi::DynString
use std::io::Display
use ingot::event::{Key, KeyCode, Modifiers, Mouse, MouseButton, MouseKind}
use ingot::frame::{Frame, fill, print_in, theme}
use ingot::geom::{Pos, Rect}
use ingot::style::{Color, Modifier, Style}
use super::{clamp_u16, drawn, drawn_text, measure}

/// The most tabs a `TabsState` records for hit-testing. A row may show
/// more, and a click on a later one selects none.
pub const MAX_TABS: usize = 32

/// The state of a row of `Tabs` that outlives a frame: the selected tab,
/// the first tab shown, and where the last render drew the tabs, which key
/// and mouse handling use.
///
/// One tab is always selected, the first unless chosen. A render clamps a
/// selection past the last tab to it, and with no tabs selects the first.
pub struct TabsState {
    selected: usize,
    first: usize,
    len: usize,
    area: Rect,
    // The cells of the first `shown` tabs drawn, from `first`.
    tabs: [Rect; MAX_TABS],
    shown: usize,
    wrap_around: bool,
}

impl Copy for TabsState {}

/// The first tab selected.
impl Default for TabsState {
    fn default() -> Self {
        TabsState::new()
    }
}

impl TabsState {
    /// The state with the first tab selected, before the first render.
    pub fn new() -> Self {
        TabsState {
            selected: 0,
            first: 0,
            len: 0,
            area: Rect::ZERO,
            tabs: [Rect::ZERO; MAX_TABS],
            shown: 0,
            wrap_around: false,
        }
    }

    /// This state with the selection moving from the last tab to the first
    /// with `select_next`, and back with `select_previous`.
    pub fn wrap_around(var own self) -> Self {
        self.wrap_around = true
        self
    }

    /// The selected tab.
    pub fn selected(self) -> usize {
        self.selected
    }

    /// The number of tabs, as the last render drew them.
    pub fn len(self) -> usize {
        self.len
    }

    /// The row the last render drew the tabs in.
    pub fn area(self) -> Rect {
        self.area
    }

    /// The first tab the last render showed: more than 0 when the tabs do
    /// not fit and the row scrolled to show the selected one.
    pub fn first(self) -> usize {
        self.first
    }

    /// Selects tab `index`. The next render clamps an index past the last
    /// tab to it.
    pub fn select(mut self, _ index: usize) {
        self.selected = index
    }

    /// Selects the tab after the selected one. From the last tab it stays,
    /// or moves to the first if the state wraps around.
    pub fn select_next(mut self) {
        if self.len == 0 { return }
        self.selected = if self.selected < self.len - 1 {
            self.selected + 1
        } else if self.wrap_around { 0 } else { self.len - 1 }
    }

    /// Selects the tab before the selected one. From the first tab it
    /// stays, or moves to the last if the state wraps around.
    pub fn select_previous(mut self) {
        if self.len == 0 { return }
        self.selected = if self.selected >= self.len {
            self.len - 1
        } else if self.selected > 0 {
            self.selected - 1
        } else if self.wrap_around { self.len - 1 } else { 0 }
    }

    /// The tab drawn at `pos` by the last render, or `None` if `pos` is on a
    /// divider or past the tabs.
    pub fn index_at(self, _ pos: Pos) -> Option<usize> {
        for (i, tab) in self.tabs.enumerate().take(self.shown) {
            if tab.contains(pos) {
                return Option::Some(self.first + i)
            }
        }
        Option::None
    }

    /// Moves the selection for a key press without modifiers: Left and
    /// Right by a tab. Returns whether the key is one of these, which the
    /// tabs take even where the selection cannot move.
    pub fn handle_key(mut self, _ key: Key) -> bool {
        if key.is(KeyCode::Left) {
            self.select_previous()
        } else if key.is(KeyCode::Right) {
            self.select_next()
        } else {
            return false
        }
        true
    }

    /// Handles a mouse event: a left click on a tab the last render drew
    /// selects it and returns its index. Other events do nothing.
    pub fn handle_mouse(mut self, _ mouse: Mouse) -> Option<usize> {
        if mouse.kind != MouseKind::Down(MouseButton::Left) {
            return Option::None
        }
        let index = self.index_at(mouse.pos)?
        self.selected = index
        Option::Some(index)
    }
}

/// A row of titles with one selected, on the top row of its area:
///
/// ```fe
/// fn view(mut self, _ area: Rect) uses (frame: mut Frame) {
///     let (head, body) = area.split_top(1)
///     Tabs::new().render(head, ["Files", "Search", "Help"], mut self.tabs)
/// }
/// ```
///
/// The titles are any indexable list of `Display` values: an array, or a
/// `MemSlice` or `MemVec` of `MemBuffer`s or `DynString`s. Each tab is its
/// title with padding on both sides, and a divider stands between tabs.
/// When the tabs do not fit, the row scrolls by whole tabs to show the
/// selected one, as little as it can from where it was.
///
/// Titles take the theme's `text` style and the selected tab its
/// `highlight` style over it, padding included; dividers take the `border`
/// style. A style set on the tabs applies over the theme's.
pub struct Tabs {
    divider: String<16>,
    padding_left: u16,
    padding_right: u16,
    style: Style,
    highlight_style: Style,
    divider_style: Style,
}

impl Copy for Tabs {}

impl Tabs {
    /// Tabs divided by `│`, with one cell of padding on each side.
    pub fn new() -> Self {
        Tabs {
            divider: "│",
            padding_left: 1,
            padding_right: 1,
            style: Style::NONE,
            highlight_style: Style::NONE,
            divider_style: Style::NONE,
        }
    }

    /// The text between two tabs.
    pub fn divider(var own self, _ divider: String<16>) -> Self {
        self.divider = divider
        self
    }

    /// The cells before and after each title.
    pub fn padding(var own self, left: u16, right: u16) -> Self {
        self.padding_left = left
        self.padding_right = right
        self
    }

    /// The style for the tabs, over the theme's `text` style.
    pub fn style(var own self, _ style: Style) -> Self {
        self.style = style
        self
    }

    /// The style for the selected tab, over the theme's `highlight` style.
    pub fn highlight_style(var own self, _ style: Style) -> Self {
        self.highlight_style = style
        self
    }

    /// The style for the dividers, over the theme's `border` style.
    pub fn divider_style(var own self, _ style: Style) -> Self {
        self.divider_style = style
        self
    }

    /// Draws `titles` on the top row of `area`, with the tab `state`
    /// selects selected, and records in `state` what it drew.
    pub fn render<C: Len + Index<usize>>(self, _ area: Rect, _ titles: C, _ state: mut TabsState)
    uses (frame: mut Frame, C::E)
    where C::Output: Display
    {
        let (row, _) = area.split_top(1)
        state.area = row
        state.shown = 0
        let count = titles.len()
        state.len = count
        if count == 0 {
            state.selected = 0
            state.first = 0
            return
        }
        if state.selected >= count {
            state.selected = count - 1
        }
        var scratch = MemBuffer::empty()
        let selected = state.selected
        state.first = self
            .scroll(
                titles,
                room: row.width as usize,
                selected,
                first: state.first,
                mut scratch,
            )
        let divider_width = measure(self.divider, mut scratch)
        let text = theme().text.patch(self.style)
        let highlight = text.patch(theme().highlight).patch(self.highlight_style)
        let divider = theme().border.patch(self.divider_style)
        var x = row.x as usize
        for i in state.first .. count {
            if x >= row.right() as usize {
                break
            }
            if i > state.first {
                print_in(part(row, x, divider_width), self.divider, divider)
                x += divider_width
            }
            let title = measure(titles[i], mut scratch)
            let width = title + self.padding_width()
            let style = if i == selected { highlight } else { text }
            let tab = part(row, x, width)
            if state.shown < MAX_TABS {
                state.tabs[state.shown] = tab
                state.shown += 1
            }
            fill(tab, " ", style)
            print_in(
                part(row, x + self.padding_left as usize, title),
                scratch.span(),
                Style::NONE,
            )
            x += width
        }
    }

    // The first tab to show in `room` columns so that tab `selected` shows
    // whole if it fits, moving as little as it can from tab `first`; and
    // the first to start no later than it must, so no room is left after
    // the last tab that an earlier one would fill.
    fn scroll<C: Len + Index<usize>>(
        self,
        _ titles: C,
        room: usize,
        selected: usize,
        first: usize,
        _ scratch: mut MemBuffer,
    ) -> usize
    uses C::E
    where C::Output: Display
    {
        let divider = measure(self.divider, mut scratch)
        var first = if first > selected { selected } else { first }
        // The columns from the start of tab `first` to the end of `selected`.
        var shown: usize = 0
        for i in first .. selected + 1 {
            shown += self.tab_width(titles[i], mut scratch) + if i > first { divider } else { 0 }
        }
        while first < selected && shown > room {
            shown -= self.tab_width(titles[first], mut scratch) + divider
            first += 1
        }
        // From there to the end of the last tab.
        for i in selected + 1 .. titles.len() {
            shown += divider + self.tab_width(titles[i], mut scratch)
        }
        while first > 0 {
            let before = self.tab_width(titles[first - 1], mut scratch) + divider
            if shown + before > room {
                break
            }
            shown += before
            first -= 1
        }
        first
    }

    // The columns of a tab with `title`, which is left in `scratch`.
    fn tab_width<T: Display>(self, _ title: T, _ scratch: mut MemBuffer) -> usize {
        measure(title, mut scratch) + self.padding_width()
    }

    fn padding_width(self) -> usize {
        self.padding_left as usize + self.padding_right as usize
    }
}

// The cells of `row` from column `x`, `width` wide, that lie in it.
fn part(_ row: Rect, _ x: usize, _ width: usize) -> Rect {
    Rect::new(
        x: clamp_u16(x),
        y: row.y,
        width: clamp_u16(width),
        height: row.height,
    ).intersect(row)
}

// A state with tab `index` selected.
fn selecting(_ index: usize) -> TabsState {
    var state = TabsState::new()
    state.select(index)
    state
}

#[test]
fn tabs_draw_titles_between_dividers() {
    let text = drawn_text(
        width: 20,
        height: 2,
        |frame, area| {
            with (frame) {
                var state = selecting(1)
                Tabs::new().render(area, ["One", "Two", "Three"], mut state)
                assert(
                    state.area() == Rect::new(x: 0, y: 0, width: 20, height: 1),
                )
            }
        },
    )
    assert(text == " One │ Two │ Three\n")
    let text = drawn_text(
        width: 20,
        height: 1,
        |frame, area| {
            with (frame) {
                var state = selecting(0)
                Tabs::new()
                    .divider(" / ")
                    .padding(left: 0, right: 0)
                    .render(area, ["a", "b", "c"], mut state)
            }
        },
    )
    assert(text == "a / b / c")
}

#[test]
fn the_selected_tab_stands_out() {
    let buffer = drawn(
        width: 12,
        height: 1,
        |frame, area| {
            with (frame) {
                var state = selecting(1)
                Tabs::new()
                    .highlight_style(Style::new().bold())
                    .render(area, ["ab", "cd"], mut state)
            }
        },
    )
    // " ab │ cd ": the selected tab is columns 5 to 8, padding included.
    for x in [5, 6, 7, 8] {
        let cell = buffer.get(Pos::new(x, y: 0)).unwrap()
        assert(cell.modifier() == Modifier::REVERSED | Modifier::BOLD)
    }
    let other = buffer.get(Pos::new(x: 1, y: 0)).unwrap()
    assert(other.fg() == Color::RESET && other.modifier().is_empty())
    assert(
        buffer.get(Pos::new(x: 4, y: 0)).unwrap().modifier() == Modifier::DIM,
    )
}

// What tabs of `titles` show in 12 columns as the selection moves through
// `selections`, each row one render with the state the last left.
fn scrolled(_ selections: [usize; 6]) -> MemBuffer {
    drawn_text(
        width: 12,
        height: 6,
        |frame, area| {
            with (frame) {
                var state = selecting(0)
                for (y, selected) in selections.enumerate() {
                    state.select(selected)
                    let row = Rect::new(x: 0, y: y.downcast_truncate(), width: 12, height: 1)
                    Tabs::new().render(row, ["Alpha", "Beta", "Gamma", "Delta"], mut state)
                }
            }
        },
    )
}

#[test]
fn tabs_scroll_to_show_the_selected_one() {
    // The tabs are 7, 6, 7 and 7 columns, with a divider between each two.
    assert(
        scrolled([0, 1, 2, 3, 2, 0])
            == " Alpha │ Bet\n Beta │ Gamm\n Gamma │ Del\n Delta\n Gamma │ Del\n Alpha │ Bet",
    )
    // A selection past the last tab selects the last.
    drawn(
        width: 12,
        height: 1,
        |frame, area| {
            with (frame) {
                var state = selecting(9)
                Tabs::new().render(area, ["Alpha", "Beta", "Gamma", "Delta"], mut state)
                assert(state.selected() == 3 && state.first() == 3)
                // A wider row shows earlier tabs again.
                Tabs::new()
                    .render(
                        Rect::new(x: 0, y: 0, width: 15, height: 1),
                        ["Alpha", "Beta", "Gamma", "Delta"],
                        mut state,
                    )
                assert(state.first() == 2)
                Tabs::new()
                    .render(
                        Rect::new(x: 0, y: 0, width: 40, height: 1),
                        ["Alpha", "Beta", "Gamma", "Delta"],
                        mut state,
                    )
                assert(state.first() == 0)
            }
        },
    )
    // A tab wider than the row shows its start.
    let text = drawn_text(
        width: 4,
        height: 1,
        |frame, area| {
            with (frame) {
                var state = selecting(1)
                Tabs::new().render(area, ["Alpha", "Beta"], mut state)
            }
        },
    )
    assert(text == " Bet")
}

#[test]
fn positions_map_back_to_tabs() {
    let titles = ["Alpha", "Beta", "Gamma", "Delta"]
    drawn(
        width: 14,
        height: 3,
        |frame, _| {
            with (frame) {
                let tabs = Tabs::new()
                var state = selecting(0)
                tabs.render(
                    Rect::new(x: 1, y: 1, width: 12, height: 2),
                    titles,
                    mut state,
                )
                assert(state.index_at(Pos::new(x: 1, y: 1)) == Option::Some(0))
                assert(state.index_at(Pos::new(x: 7, y: 1)) == Option::Some(0))
                assert(state.index_at(Pos::new(x: 8, y: 1)).is_none())
                assert(state.index_at(Pos::new(x: 9, y: 1)) == Option::Some(1))
                assert(state.index_at(Pos::new(x: 12, y: 1)) == Option::Some(1))
                assert(state.index_at(Pos::new(x: 13, y: 1)).is_none())
                assert(state.index_at(Pos::new(x: 0, y: 1)).is_none())
                assert(state.index_at(Pos::new(x: 3, y: 2)).is_none())
                state.select(3)
                tabs.render(
                    Rect::new(x: 1, y: 1, width: 12, height: 2),
                    titles,
                    mut state,
                )
                assert(state.index_at(Pos::new(x: 1, y: 1)) == Option::Some(3))
                assert(state.index_at(Pos::new(x: 8, y: 1)).is_none())
            }
        },
    )
}

#[test]
fn titles_may_be_buffers_or_strings() {
    var buffers: MemVec<MemBuffer> = MemVec::new()
    buffers.push(format!("log"))
    buffers.push(format!("tab ", 2 as u8))
    var strings: MemVec<DynString> = MemVec::new()
    strings.push("x")
    strings.push("a title longer than thirty-one bytes")
    let text = drawn_text(
        width: 24,
        height: 3,
        |frame, area| {
            with (frame) {
                var state = selecting(0)
                let (first, rest) = area.split_top(1)
                Tabs::new().render(first, buffers.as_slice(), mut state)
                let (second, third) = rest.split_top(1)
                Tabs::new().render(second, strings.as_slice(), mut state)
                Tabs::new().render(third, strings, mut state)
            }
        },
    )
    assert(
        text == " log │ tab 2\n x │ a title longer than\n x │ a title longer than",
    )
}

#[test]
fn tabs_draw_nothing_without_room_or_titles() {
    let empty: [String<1>; 0] = []
    let text = drawn_text(
        width: 5,
        height: 2,
        |frame, area| {
            with (frame) {
                fill(area, ".", Style::new())
                var state = selecting(2)
                Tabs::new().render(area, empty, mut state)
                assert(state.selected() == 0)
                Tabs::new()
                    .render(
                        Rect::new(x: 1, y: 1, width: 0, height: 1),
                        ["a", "b"],
                        mut state,
                    )
                Tabs::new()
                    .render(
                        Rect::new(x: 1, y: 1, width: 3, height: 0),
                        ["a", "b"],
                        mut state,
                    )
                Tabs::new()
                    .render(
                        Rect::new(x: 1, y: 1, width: 3, height: 1),
                        ["a", "b"],
                        mut state,
                    )
                assert(state.index_at(Pos::new(x: 4, y: 1)).is_none())
            }
        },
    )
    assert(text == ".....\n. a .")
}

#[test]
fn keys_and_clicks_select_tabs() {
    drawn(
        width: 20,
        height: 1,
        |frame, area| {
            with (frame) {
                let titles = ["One", "Two", "Three"]
                var state = TabsState::new()
                // Before a render there are no tabs to move to.
                state.select_next()
                assert(state.selected() == 0)
                Tabs::new().render(area, titles, mut state)
                assert(state.len() == 3)
                let right = Key::new(KeyCode::Right, Modifiers::NONE)
                let left = Key::new(KeyCode::Left, Modifiers::NONE)
                assert(state.handle_key(right) && state.selected() == 1)
                assert(state.handle_key(right) && state.handle_key(right))
                assert(state.selected() == 2)
                assert(state.handle_key(left) && state.selected() == 1)
                assert(
                    !state.handle_key(Key::new(KeyCode::Right, Modifiers::CTRL)),
                )
                assert(!state.handle_key(Key::new(KeyCode::Up, Modifiers::NONE)))
                // " One │ Two │ Three": a click on "Three", on a divider, and
                // with another button.
                let click = |x: u16| Mouse::new(
                    MouseKind::Down(MouseButton::Left),
                    Pos::new(x, y: 0),
                    Modifiers::NONE,
                )
                assert(state.handle_mouse(click(14)) == Option::Some(2))
                assert(state.selected() == 2)
                assert(state.handle_mouse(click(5)).is_none())
                assert(
                    state
                        .handle_mouse(
                            Mouse::new(
                                MouseKind::Down(MouseButton::Right),
                                Pos::new(x: 1, y: 0),
                                Modifiers::NONE,
                            ),
                        )
                        .is_none(),
                )
                assert(state.selected() == 2)
                var wrapping = TabsState::new().wrap_around()
                Tabs::new().render(area, titles, mut wrapping)
                wrapping.select_previous()
                assert(wrapping.selected() == 2)
                wrapping.select_next()
                assert(wrapping.selected() == 0)
            }
        },
    )
}
