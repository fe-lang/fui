//! Clearing an area, for what is drawn over other widgets.
use ingot::frame::{Frame, drawn, drawn_text, fill}
use ingot::geom::{Pos, Rect}
use ingot::style::{Color, Style}
use super::Block

/// Makes every cell of `area` empty: a space in the terminal's default
/// colors, without attributes. What was drawn there before no longer
/// shows through what is drawn next:
///
/// ```fe
/// fn view(_ area: Rect, _ names: MemSlice<MemBuffer>, _ files: mut ListState) uses (frame: mut Frame) {
///     List::new().render(area, names, mut files)
///     let dialog = area.centered(width: 30, height: 5)
///     clear(dialog)
///     Block::bordered().render_titled(dialog, "Quit?")
/// }
/// ```
pub fn clear(_ area: Rect) uses (frame: mut Frame) {
    frame.clear(area)
}

/// The rectangle of at most `width` by `height` cells in the middle of
/// `area`, cleared, for a popup to draw in:
///
/// ```fe
/// fn view(_ area: Rect, _ names: MemSlice<MemBuffer>, _ files: mut ListState) uses (frame: mut Frame) {
///     List::new().render(area, names, mut files)
///     let inner = Block::bordered().render_titled(popup(area, width: 30, height: 5), "Quit?")
///     Paragraph::new().centered().render(inner, "y / n")
/// }
/// ```
pub fn popup(_ area: Rect, width: u16, height: u16) -> Rect
uses (frame: mut Frame)
{
    let popup = area.centered(width, height)
    frame.clear(popup)
    popup
}

#[test]
fn clearing_resets_cells() {
    let buffer = drawn(
        width: 4,
        height: 3,
        |frame, area| {
            with (frame) {
                fill(area, "x", Style::new().fg(Color::RED).bold())
                clear(Rect::new(x: 1, y: 1, width: 9, height: 1))
                clear(Rect::new(x: 0, y: 0, width: 0, height: 3))
                clear(Rect::new(x: 9, y: 9, width: 2, height: 2))
            }
        },
    )
    assert(buffer.to_text() == "xxxx\nx\nxxxx")
    let cell = buffer.get(Pos::new(x: 2, y: 1)).unwrap()
    assert(cell.fg() == Color::RESET && cell.modifier().is_empty())
}

#[test]
fn popups_are_centered_and_cleared() {
    let text = drawn_text(
        width: 9,
        height: 5,
        |frame, area| {
            with (frame) {
                fill(area, ".", Style::new())
                let inner = Block::bordered().render(popup(area, width: 5, height: 3))
                assert(inner == Rect::new(x: 3, y: 2, width: 3, height: 1))
            }
        },
    )
    assert(
        text == ".........\n..┌───┐..\n..│   │..\n..└───┘..\n.........",
    )
    let text = drawn_text(
        width: 4,
        height: 2,
        |frame, area| {
            with (frame) {
                fill(area, ".", Style::new())
                assert(popup(area, width: 9, height: 9) == area)
                assert(popup(area, width: 0, height: 1).is_empty())
            }
        },
    )
    assert(text == "\n")
}
