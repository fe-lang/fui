//! Terminal input: a parser that turns the bytes a terminal sends into
//! `Event`s, and the control sequences that turn its input modes on and off
//! and ask it questions.
//!
//! The parser reads what xterm, VTE (GNOME Terminal), kitty, WezTerm,
//! Alacritty, iTerm2, macOS Terminal, tmux and the Linux console send:
//! UTF-8 text, control keys, the CSI and SS3 key sequences with their
//! modifiers, Alt as an `ESC` prefix, SGR and X10 mouse reports, bracketed
//! paste, focus reports, the kitty keyboard protocol and xterm's
//! `modifyOtherKeys`, and the replies to the queries below. It never
//! panics, holds a bounded amount of memory whatever it is fed, and starts
//! afresh after a sequence it does not know.
//!
//! Some bytes mean one thing or another:
//!
//! - A lone `ESC` is the Esc key, or the start of a sequence, or the Alt
//!   prefix of the next key. The parser waits: a program calls `flush` when
//!   no more input arrived within a short timeout (`is_pending` says when
//!   to wait), which makes it the Esc key. The kitty protocol's
//!   `KeyboardFlags::DISAMBIGUATE` sends Esc as a sequence of its own.
//! - `0x08` is Backspace. Modern terminals send `0x7f` for Backspace and
//!   `0x08` for Ctrl+H or Ctrl+Backspace, while some send `0x08` for
//!   Backspace itself; reading it as Backspace keeps text fields working
//!   everywhere. A program that binds Ctrl+H needs the kitty protocol.
//! - `0x00` is Ctrl+Space, `0x0a` and `0x0d` are Enter, `0x09` is Tab, and
//!   `0x1c` to `0x1f` are Ctrl with `\`, `]`, `^` and `_`.
//! - `CSI 1 ; m R` is Shift+F3 (or F3 with other modifiers) from xterm, or
//!   a cursor position report for row 1. It is a report only after
//!   `Parser::request_cursor_position`.
//! - `ESC P`, `ESC ]` and `ESC _` begin terminal strings (DCS, OSC, APC)
//!   and are also Alt+Shift+P, Alt+] and Alt+_. A string with nothing in it
//!   when `flush` comes is that key.
use core::{MemBuffer, MemSpan, MemVec, Option}
use core::mem::replace
use core::ops::Eq
use ingot::event::{
    Event,
    Key,
    KeyCode,
    KeyKind,
    KeyboardFlags,
    ModeSetting,
    Modifiers,
    Mouse,
    MouseButton,
    MouseKind,
    Reply,
}
use ingot::geom::Pos

/// The most bytes one `Event::Paste` holds. A longer paste arrives as
/// several, in order, each cut at a UTF-8 boundary, so a paste whose end
/// never comes holds at most this much.
pub const MAX_PASTE: usize = 1048576

/// The most bytes of a terminal string (OSC, DCS, APC) the parser keeps.
/// It reads longer strings to their end and keeps only their start, which
/// is all the replies it reads need.
pub const MAX_STRING: usize = 64

// The parameters of a CSI sequence the parser keeps. Later ones are read
// and dropped: every sequence it acts on has at most three.
const MAX_FIELDS: usize = 8

// A parameter's value stops growing here, above every value that means
// anything, so no sequence of digits overflows it.
const MAX_PARAM: u32 = 0xffffff

const ESC: u8 = 0x1b

// What the parser is in the middle of.
enum State {
    // Between sequences.
    Ground,
    // After an `ESC`.
    Escape,
    // In a CSI sequence, after `ESC [`.
    Csi,
    // In an SS3 sequence, after `ESC O`.
    Ss3,
    // After `ESC [ [`, the Linux console's F1 to F5.
    LinuxFunction,
    // In the three bytes of an X10 mouse report, after `ESC [ M`.
    X10,
    // In a multi-byte UTF-8 scalar.
    Utf8,
    // In a terminal string (OSC, DCS, APC).
    Text,
    // After an `ESC` in a terminal string, which a `\` makes its end.
    TextEscape,
    // In a bracketed paste.
    Paste,
}

impl Copy for State {}

impl Eq for State {
    fn eq(self, _ other: Self) -> bool {
        self.index() == other.index()
    }
}

impl State {
    fn index(self) -> u8 {
        match self {
            State::Ground => 0,
            State::Escape => 1,
            State::Csi => 2,
            State::Ss3 => 3,
            State::LinuxFunction => 4,
            State::X10 => 5,
            State::Utf8 => 6,
            State::Text => 7,
            State::TextEscape => 8,
            State::Paste => 9,
        }
    }
}

/// A push parser of terminal input. Feed it the bytes as they arrive; it
/// keeps an incomplete sequence for the next `feed`.
///
/// ```fe
/// var parser = Parser::new()
/// var events: MemVec<Event> = MemVec::new()
/// parser.feed(bytes.span(), mut events)
/// // no more bytes within ~30 ms, and `parser.is_pending()`:
/// parser.flush(mut events)
/// ```
pub struct Parser {
    state: State,
    // An `ESC` came before the sequence in progress: its key has Alt.
    alt: bool,
    // The bytes of the sequence in progress after its introducer.
    len: usize,
    // A CSI or SS3 sequence's private marker (`<`, `=`, `>`, `?`) or 0.
    marker: u8,
    // A CSI sequence's intermediate byte or 0.
    intermediate: u8,
    // The sequence cannot mean anything: it is read to its end and dropped.
    invalid: bool,
    // A parameter byte came.
    params: bool,
    // Each `;`-separated parameter's value and its first `:` sub-parameter.
    fields: [u32; 8],
    seconds: [u32; 8],
    // The parameter being read, and its `:` sub-parameter.
    field: usize,
    sub: usize,
    // The UTF-8 scalar being read, the continuation bytes it still needs,
    // and the range the next one must lie in.
    scalar: u32,
    need: u8,
    low: u8,
    high: u8,
    // The terminal string's introducer and the start of its content.
    text_kind: u8,
    text: MemBuffer,
    // An X10 mouse report's bytes so far, and the button pressed last,
    // which its release does not name.
    x10: [u8; 3],
    last_button: MouseButton,
    // The paste so far, and how many bytes of its end marker it ends with.
    paste: MemBuffer,
    paste_end: usize,
    // Cursor position reports asked for and not yet read.
    positions: u8,
}

impl Parser {
    /// A parser between sequences.
    pub fn new() -> Self {
        Parser {
            state: State::Ground,
            alt: false,
            len: 0,
            marker: 0,
            intermediate: 0,
            invalid: false,
            params: false,
            fields: [0; 8],
            seconds: [0; 8],
            field: 0,
            sub: 0,
            scalar: 0,
            need: 0,
            low: 0,
            high: 0,
            text_kind: 0,
            text: MemBuffer::empty(),
            x10: [0; 3],
            last_button: MouseButton::Left,
            paste: MemBuffer::empty(),
            paste_end: 0,
            positions: 0,
        }
    }

    /// Reads `bytes`, appending to `events` each event they complete. A
    /// sequence they leave incomplete waits for the next `feed` or `flush`.
    pub fn feed(mut self, _ bytes: MemSpan, _ events: mut MemVec<Event>) {
        for b in bytes {
            self.byte(b, mut events)
        }
    }

    /// Whether the parser holds an incomplete sequence that `flush` would
    /// resolve, so the program should wait only a short time for more input
    /// before calling it. An unfinished paste does not count: it waits for
    /// its end however long it takes.
    pub fn is_pending(self) -> bool {
        self.state != State::Ground && self.state != State::Paste
    }

    /// Resolves the incomplete sequence, once no more input arrived within a
    /// short timeout: a lone `ESC` is the Esc key, `ESC` with the start of a
    /// sequence that went no further is Alt with that key (`ESC [` is
    /// Alt+[), an incomplete UTF-8 scalar is U+FFFD, and anything else
    /// incomplete is dropped. A paste in progress stays.
    pub fn flush(mut self, _ events: mut MemVec<Event>) {
        let state = self.state
        match state {
            State::Ground => {},
            State::Paste => {},
            State::Escape => self.key(mut events, KeyCode::Esc, Modifiers::NONE),
            State::Csi => self.lone_introducer(mut events, b'['),
            State::Ss3 => self.lone_introducer(mut events, b'O'),
            State::Text => self.lone_introducer(mut events, self.text_kind),
            State::TextEscape => {
                self.lone_introducer(mut events, self.text_kind)
                self.key(mut events, KeyCode::Esc, Modifiers::NONE)
            },
            State::Utf8 => self.key(mut events, KeyCode::Unicode(0xfffd), Modifiers::NONE),
            State::LinuxFunction => {},
            State::X10 => {},
        }
        if self.state != State::Paste {
            self.reset()
        }
    }

    /// Appends the query for the cursor's position (`CSI 6 n`) to `out`, and
    /// makes the parser read the next `CSI r ; c R` as its reply,
    /// `Reply::CursorPosition`, rather than as F3 with modifiers.
    pub fn request_cursor_position(mut self, _ out: mut MemBuffer) {
        push_csi(mut out)
        write!(mut out, "6n")
        if self.positions < 255 {
            self.positions += 1
        }
    }

    // Back between sequences.
    fn reset(mut self) {
        self.state = State::Ground
        self.alt = false
    }

    // Emits a key, with Alt if an `ESC` came before it, and ends the
    // sequence.
    fn key(mut self, _ events: mut MemVec<Event>, _ code: KeyCode, _ mods: Modifiers) {
        self.key_of(mut events, code, mods, KeyKind::Press)
    }

    fn key_of(
        mut self,
        _ events: mut MemVec<Event>,
        _ code: KeyCode,
        _ mods: Modifiers,
        _ kind: KeyKind,
    ) {
        let mods = if self.alt {
            mods | Modifiers::ALT
        } else {
            mods
        }
        events.push(Event::Key(Key { code, mods, kind }))
        self.reset()
    }

    // Emits an event other than a key, and ends the sequence.
    fn event(mut self, _ events: mut MemVec<Event>, _ event: own Event) {
        events.push(event)
        self.reset()
    }

    // At `flush`, an introducer with nothing after it was Alt and its byte.
    fn lone_introducer(mut self, _ events: mut MemVec<Event>, _ introducer: u8) {
        if self.len == 0 {
            self.key(mut events, KeyCode::Char(introducer), Modifiers::ALT)
        }
    }

    // Starts a CSI or SS3 sequence.
    fn begin(mut self, _ state: State) {
        self.state = state
        self.len = 0
        self.marker = 0
        self.intermediate = 0
        self.invalid = false
        self.params = false
        self.fields = [0; 8]
        self.seconds = [0; 8]
        self.field = 0
        self.sub = 0
    }

    fn byte(mut self, _ b: u8, _ events: mut MemVec<Event>) {
        let state = self.state
        match state {
            State::Ground => self.ground(b, mut events),
            State::Escape => self.escape(b, mut events),
            State::Csi => self.csi(b, mut events),
            State::Ss3 => self.ss3(b, mut events),
            State::LinuxFunction => if b >= b'A' && b <= b'E' {
                self.key(mut events, KeyCode::F(b - b'A' + 1), Modifiers::NONE)
            } else {
                self.restart(b, mut events)
            },
            State::X10 => self.x10(b, mut events),
            State::Utf8 => self.utf8(b, mut events),
            State::Text => self.text(b, mut events),
            State::TextEscape => if b == b'\\' {
                self.end_text(mut events)
            } else {
                // An `ESC` that is no string terminator ends the string
                // unread and begins a sequence of its own. An empty string
                // was Alt and its introducer, as at `flush`.
                self.lone_introducer(mut events, self.text_kind)
                self.reset()
                self.state = State::Escape
                self.escape(b, mut events)
            },
            State::Paste => self.paste(b, mut events),
        }
    }

    // Drops the sequence in progress, which `b` cannot continue, and reads
    // `b` afresh.
    fn restart(mut self, _ b: u8, _ events: mut MemVec<Event>) {
        self.reset()
        self.ground(b, mut events)
    }

    fn ground(mut self, _ b: u8, _ events: mut MemVec<Event>) {
        if b == ESC {
            self.state = State::Escape
        } else if b >= 0x20 && b < 0x7f {
            self.key(mut events, KeyCode::Char(b), Modifiers::NONE)
        } else if b < 0x80 {
            let (code, mods) = control_key(b)
            self.key(mut events, code, mods)
        } else {
            self.utf8_lead(b, mut events)
        }
    }

    fn escape(mut self, _ b: u8, _ events: mut MemVec<Event>) {
        if b == ESC {
            if self.alt {
                // `ESC ESC ESC`: Alt+Esc, then a new `ESC`.
                self.key(mut events, KeyCode::Esc, Modifiers::NONE)
                self.state = State::Escape
            } else {
                // `ESC ESC`: Alt with whatever the second `ESC` begins.
                self.alt = true
            }
        } else if b == b'[' {
            self.begin(State::Csi)
        } else if b == b'O' {
            self.begin(State::Ss3)
        } else if b == b']' || b == b'P' || b == b'_' {
            self.state = State::Text
            self.text_kind = b
            self.len = 0
            self.text.clear()
        } else {
            self.alt = true
            self.ground(b, mut events)
        }
    }

    // Reads a parameter byte (`0`-`9`, `:`, `;`) of a CSI or SS3 sequence.
    fn parameter(mut self, _ b: u8) {
        self.params = true
        if self.intermediate != 0 {
            self.invalid = true
        } else if b == b';' {
            self.field += 1
            self.sub = 0
        } else if b == b':' {
            self.sub += 1
        } else if self.field < MAX_FIELDS && self.sub < 2 {
            let digit = (b - b'0') as u32
            if self.sub == 0 {
                self.fields[self.field] = grow(self.fields[self.field], digit)
            } else {
                self.seconds[self.field] = grow(self.seconds[self.field], digit)
            }
        }
    }

    // The number of parameters read, empty ones included.
    fn count(self) -> usize {
        if !self.params { return 0 }
        if self.field < MAX_FIELDS {
            self.field + 1
        } else {
            MAX_FIELDS
        }
    }

    fn csi(mut self, _ b: u8, _ events: mut MemVec<Event>) {
        if b >= 0x30 && b <= 0x3b {
            self.parameter(b)
        } else if b >= 0x3c && b <= 0x3f {
            // A private marker is the first byte, or the sequence means
            // nothing.
            if self.len == 0 {
                self.marker = b
            } else {
                self.invalid = true
            }
        } else if b >= 0x20 && b <= 0x2f {
            if self.intermediate == 0 {
                self.intermediate = b
            } else {
                self.invalid = true
            }
        } else if b >= 0x40 && b <= 0x7e {
            if self.len == 0 && b == b'[' {
                self.state = State::LinuxFunction
            } else if self.len == 0 && b == b'M' {
                self.state = State::X10
                self.len = 0
            } else if self.invalid {
                self.reset()
            } else {
                self.dispatch_csi(b, mut events)
            }
            return
        } else if b == ESC {
            self.reset()
            self.state = State::Escape
            return
        } else {
            // A control or non-ASCII byte cannot be in a sequence: the user
            // typed it after an `ESC [`.
            self.restart(b, mut events)
            return
        }
        self.len = self.len.saturating_add(1)
    }

    fn ss3(mut self, _ b: u8, _ events: mut MemVec<Event>) {
        if b >= 0x30 && b <= 0x3b {
            // Some terminals send modifiers in SS3: `ESC O 5 P`, `ESC O 1 ; 5 P`.
            self.parameter(b)
            self.len = self.len.saturating_add(1)
            return
        }
        if b < 0x40 || b > 0x7e {
            if b == ESC {
                self.reset()
                self.state = State::Escape
            } else {
                self.restart(b, mut events)
            }
            return
        }
        let mods = modifiers(
            if self.count() >= 2 {
                self.fields[1]
            } else {
                self.fields[0]
            },
        )
        match ss3_key(b) {
            Option::Some(code) => self.key(mut events, code, mods),
            Option::None => self.reset(),
        }
    }

    fn dispatch_csi(mut self, _ final_byte: u8, _ events: mut MemVec<Event>) {
        let count = self.count()
        let p0 = self.fields[0]
        let p1 = self.fields[1]
        let p2 = self.fields[2]
        if self.marker == b'<' {
            if (final_byte == b'M' || final_byte == b'm') && count == 3 && self.intermediate == 0 {
                self.mouse(mut events, p0, x: p1, y: p2, release: final_byte == b'm')
            } else {
                self.reset()
            }
            return
        }
        if self.marker == b'?' {
            if final_byte == b'u' && self.intermediate == 0 {
                let flags = KeyboardFlags::from_bits((p0 & 0xff).downcast_truncate())
                self.event(mut events, Event::Reply(Reply::KeyboardFlags(flags)))
            } else if final_byte == b'c' && self.intermediate == 0 {
                self.event(mut events, Event::Reply(Reply::DeviceAttributes))
            } else if final_byte == b'y' && self.intermediate == b'$' && count == 2 {
                let mode = Reply::Mode(clamp(p0), ModeSetting::from_value(p1))
                self.event(mut events, Event::Reply(mode))
            } else if final_byte == b'R' && self.intermediate == 0 && count >= 2 {
                // DECXCPR: `CSI ? r ; c R`, unambiguous.
                self.cursor_position(mut events, row: p0, column: p1)
            } else {
                self.reset()
            }
            return
        }
        if self.marker != 0 || self.intermediate != 0 {
            self.reset()
            return
        }
        let mods = modifiers(p1)
        let kind = key_kind(self.seconds[1])
        if final_byte == b'u' {
            self.kitty_key(mut events, p0, mods, kind)
        } else if final_byte == b'~' {
            if p0 == 27 && count >= 3 {
                // xterm's modifyOtherKeys, as tmux sends it: `CSI 27 ; m ; code ~`.
                self.kitty_key(mut events, p2, mods, KeyKind::Press)
            } else if p0 == 200 {
                self.reset()
                self.state = State::Paste
                self.paste_end = 0
            } else {
                match tilde_key(p0) {
                    Option::Some(code) => self.key_of(mut events, code, mods, kind),
                    Option::None => self.reset(),
                }
            }
        } else if final_byte == b'R' && count == 2 {
            if self.positions == 0 && p0 == 1 && p1 >= 2 {
                self.key_of(mut events, KeyCode::F(3), mods, kind)
            } else {
                self.cursor_position(mut events, row: p0, column: p1)
            }
        } else if final_byte == b'I' && count == 0 {
            self.event(mut events, Event::FocusGained)
        } else if final_byte == b'O' && count == 0 {
            self.event(mut events, Event::FocusLost)
        } else if final_byte == b'M' && count == 3 {
            // urxvt's mode 1015: the X10 values in decimal.
            if p0 >= 32 {
                self.x10_mouse(mut events, p0 - 32, x: p1, y: p2)
            } else {
                self.reset()
            }
        } else if final_byte == b'Z' {
            // Shift+Tab: BackTab means Shift already.
            self.key_of(
                mut events,
                KeyCode::BackTab,
                mods.without(Modifiers::SHIFT),
                kind,
            )
        } else {
            match letter_key(final_byte) {
                Option::Some(code) => self.key_of(mut events, code, mods, kind),
                Option::None => self.reset(),
            }
        }
    }

    // A kitty protocol key, `CSI code ; mods : kind u`, whose alternate keys
    // and text are dropped.
    fn kitty_key(
        mut self,
        _ events: mut MemVec<Event>,
        _ code: u32,
        _ mods: Modifiers,
        _ kind: KeyKind,
    ) {
        match kitty_code(code) {
            Option::Some(KeyCode::Tab) => if mods.contains(Modifiers::SHIFT) {
                self.key_of(
                    mut events,
                    KeyCode::BackTab,
                    mods.without(Modifiers::SHIFT),
                    kind,
                )
            } else {
                self.key_of(mut events, KeyCode::Tab, mods, kind)
            },
            Option::Some(key) => self.key_of(mut events, key, mods, kind),
            Option::None => self.reset(),
        }
    }

    fn cursor_position(mut self, _ events: mut MemVec<Event>, row: u32, column: u32) {
        if self.positions > 0 {
            self.positions -= 1
        }
        let pos = Pos::new(
            x: clamp(column.saturating_sub(1)),
            y: clamp(row.saturating_sub(1)),
        )
        self.event(mut events, Event::Reply(Reply::CursorPosition(pos)))
    }

    fn x10(mut self, _ b: u8, _ events: mut MemVec<Event>) {
        if b < 0x20 {
            self.restart(b, mut events)
            return
        }
        self.x10[self.len] = b
        self.len += 1
        if self.len == 3 {
            let cb = (self.x10[0] - 32) as u32
            // Coordinates are offset by 32 and one-based.
            let x = (self.x10[1] - 32) as u32
            let y = (self.x10[2] - 32) as u32
            self.x10_mouse(mut events, cb, x, y)
        }
    }

    // An X10 or urxvt report, whose button 3 is a release of the button
    // pressed last.
    fn x10_mouse(mut self, _ events: mut MemVec<Event>, _ cb: u32, x: u32, y: u32) {
        if cb & 0x63 == 3 {
            let pos = cell(x, y)
            let mouse = Mouse::new(MouseKind::Up(self.last_button), pos, mouse_modifiers(cb))
            self.event(mut events, Event::Mouse(mouse))
        } else {
            self.mouse(mut events, cb, x, y, release: false)
        }
    }

    // A mouse report with SGR's button code `cb` at the one-based cell
    // `x`, `y`.
    fn mouse(mut self, _ events: mut MemVec<Event>, _ cb: u32, x: u32, y: u32, release: bool) {
        let pos = cell(x, y)
        let mods = mouse_modifiers(cb)
        let low = cb & 3
        if cb & 64 != 0 {
            let kind = match low {
                0 => MouseKind::ScrollUp,
                1 => MouseKind::ScrollDown,
                2 => MouseKind::ScrollLeft,
                _ => MouseKind::ScrollRight,
            }
            if release || cb & 128 != 0 {
                self.reset()
            } else {
                self.event(mut events, Event::Mouse(Mouse::new(kind, pos, mods)))
            }
            return
        }
        let button = if cb & 128 != 0 {
            match low {
                0 => Option::Some(MouseButton::Back),
                1 => Option::Some(MouseButton::Forward),
                _ => Option::None,
            }
        } else {
            match low {
                0 => Option::Some(MouseButton::Left),
                1 => Option::Some(MouseButton::Middle),
                2 => Option::Some(MouseButton::Right),
                _ => Option::None,
            }
        }
        let kind = match button {
            Option::Some(button) => if cb & 32 != 0 {
                MouseKind::Drag(button)
            } else if release {
                MouseKind::Up(button)
            } else {
                self.last_button = button
                MouseKind::Down(button)
            },
            Option::None => if cb & 32 != 0 {
                MouseKind::Moved
            } else if release {
                MouseKind::Up(self.last_button)
            } else {
                self.reset()
                return
            },
        }
        self.event(mut events, Event::Mouse(Mouse::new(kind, pos, mods)))
    }

    fn utf8_lead(mut self, _ b: u8, _ events: mut MemVec<Event>) {
        // The ranges of well-formed UTF-8 (Unicode table 3-7): no overlong
        // forms, no surrogates, nothing above U+10FFFF.
        self.low = 0x80
        self.high = 0xbf
        if b >= 0xc2 && b <= 0xdf {
            self.need = 1
            self.scalar = (b & 0x1f) as u32
        } else if b >= 0xe0 && b <= 0xef {
            self.need = 2
            self.scalar = (b & 0x0f) as u32
            if b == 0xe0 {
                self.low = 0xa0
            } else if b == 0xed {
                self.high = 0x9f
            }
        } else if b >= 0xf0 && b <= 0xf4 {
            self.need = 3
            self.scalar = (b & 0x07) as u32
            if b == 0xf0 {
                self.low = 0x90
            } else if b == 0xf4 {
                self.high = 0x8f
            }
        } else {
            self.key(mut events, KeyCode::Unicode(0xfffd), Modifiers::NONE)
            return
        }
        self.state = State::Utf8
    }

    fn utf8(mut self, _ b: u8, _ events: mut MemVec<Event>) {
        if b < self.low || b > self.high {
            // The scalar ends early: U+FFFD for it, and `b` read afresh.
            self.key(mut events, KeyCode::Unicode(0xfffd), Modifiers::NONE)
            self.ground(b, mut events)
            return
        }
        self.scalar = self.scalar << 6 | (b & 0x3f) as u32
        self.low = 0x80
        self.high = 0xbf
        self.need -= 1
        if self.need == 0 {
            self.key(mut events, KeyCode::Unicode(self.scalar), Modifiers::NONE)
        }
    }

    fn text(mut self, _ b: u8, _ events: mut MemVec<Event>) {
        if b == 0x07 {
            self.end_text(mut events)
        } else if b == ESC {
            self.state = State::TextEscape
        } else if b == 0x18 || b == 0x1a {
            // CAN and SUB cancel a string.
            self.reset()
        } else {
            if self.text.len() < MAX_STRING {
                self.text.push(b)
            }
            self.len = self.len.saturating_add(1)
        }
    }

    // A complete terminal string: the replies to `request_colors` are read,
    // the rest dropped.
    fn end_text(mut self, _ events: mut MemVec<Event>) {
        if self.text_kind == b']' {
            let reply = default_color(self.text.span())
            match reply {
                Option::Some(reply) => {
                    self.event(mut events, Event::Reply(reply))
                    return
                },
                Option::None => {},
            }
        }
        self.reset()
    }

    fn paste(mut self, _ b: u8, _ events: mut MemVec<Event>) {
        // The end marker, `ESC [ 2 0 1 ~`, holds its first byte once only,
        // so a mismatch restarts the match at that byte.
        self.paste.push(b)
        self.paste_end = if b == paste_end_byte(self.paste_end) {
            self.paste_end + 1
        } else if b == ESC { 1 } else { 0 }
        if self.paste_end == 6 {
            let len = self.paste.len() - 6
            self.paste.truncate(len)
            let text = replace(mut self.paste, MemBuffer::empty())
            self.paste_end = 0
            self.event(mut events, Event::Paste(text))
        } else if self.paste.len() - self.paste_end >= MAX_PASTE {
            // Bytes that may begin the end marker stay for the next piece.
            let cut = utf8_boundary(self.paste.slice(offset: 0, len: MAX_PASTE))
            let rest = MemBuffer::from_span(
                self.paste.slice(offset: cut, len: self.paste.len() - cut),
            )
            self.paste.truncate(cut)
            events.push(Event::Paste(replace(mut self.paste, rest)))
        }
    }
}

// The byte of the paste end marker at `index`, below 6.
fn paste_end_byte(_ index: usize) -> u8 {
    match index {
        0 => ESC,
        1 => b'[',
        2 => b'2',
        3 => b'0',
        4 => b'1',
        _ => b'~',
    }
}

// The length of `bytes` without an incomplete UTF-8 scalar at its end.
fn utf8_boundary(_ bytes: MemSpan) -> usize {
    let len = bytes.len()
    var back: usize = 1
    while back <= 3 && back <= len {
        let b = bytes[len - back]
        if b < 0x80 { return len }
        if b >= 0xc0 {
            let size: usize = if b >= 0xf0 {
                4
            } else if b >= 0xe0 { 3 } else { 2 }
            return if size > back { len - back } else { len }
        }
        back += 1
    }
    len
}

// `value * 10 + digit`, stopping at `MAX_PARAM`.
fn grow(_ value: u32, _ digit: u32) -> u32 {
    let next = value * 10 + digit
    if next > MAX_PARAM { MAX_PARAM } else { next }
}

fn clamp(_ value: u32) -> u16 {
    if value > 65535 {
        65535
    } else {
        value.downcast_truncate()
    }
}

// The zero-based cell of a one-based report.
fn cell(_ x: u32, _ y: u32) -> Pos {
    Pos::new(
        x: clamp(x.saturating_sub(1)),
        y: clamp(y.saturating_sub(1)),
    )
}

// The modifiers of a key parameter: 1 plus the bits, 0 or 1 for none. The
// lock bits (64 Caps Lock, 128 Num Lock) are dropped.
fn modifiers(_ value: u32) -> Modifiers {
    if value <= 1 {
        return Modifiers::NONE
    }
    Modifiers::from_bits(((value - 1) & 0x3f).downcast_truncate())
}

// The modifiers of a mouse report: 4 Shift, 8 Alt, 16 Ctrl.
fn mouse_modifiers(_ cb: u32) -> Modifiers {
    var mods = Modifiers::NONE
    if cb & 4 != 0 {
        mods = mods | Modifiers::SHIFT
    }
    if cb & 8 != 0 {
        mods = mods | Modifiers::ALT
    }
    if cb & 16 != 0 {
        mods = mods | Modifiers::CTRL
    }
    mods
}

// The kitty protocol's event type: 1 or none a press, 2 a repeat, 3 a
// release.
fn key_kind(_ value: u32) -> KeyKind {
    match value {
        2 => KeyKind::Repeat,
        3 => KeyKind::Release,
        _ => KeyKind::Press,
    }
}

// The key of a C0 control byte or DEL.
fn control_key(_ b: u8) -> (KeyCode, Modifiers) {
    match b {
        0x00 => (KeyCode::Char(b' '), Modifiers::CTRL),
        0x08 => (KeyCode::Backspace, Modifiers::NONE),
        0x7f => (KeyCode::Backspace, Modifiers::NONE),
        0x09 => (KeyCode::Tab, Modifiers::NONE),
        0x0a => (KeyCode::Enter, Modifiers::NONE),
        0x0d => (KeyCode::Enter, Modifiers::NONE),
        0x1b => (KeyCode::Esc, Modifiers::NONE),
        _ => if b < 0x1b {
            // Ctrl+A to Ctrl+Z.
            (KeyCode::Char(b + 0x60), Modifiers::CTRL)
        } else {
            // Ctrl with `\`, `]`, `^`, `_`.
            (KeyCode::Char(b + 0x40), Modifiers::CTRL)
        },
    }
}

// The key of a CSI sequence's final letter: `CSI A` or `CSI 1 ; m A`.
fn letter_key(_ b: u8) -> Option<KeyCode> {
    match b {
        b'A' => Option::Some(KeyCode::Up),
        b'B' => Option::Some(KeyCode::Down),
        b'C' => Option::Some(KeyCode::Right),
        b'D' => Option::Some(KeyCode::Left),
        b'E' => Option::Some(KeyCode::KeypadBegin),
        b'F' => Option::Some(KeyCode::End),
        b'H' => Option::Some(KeyCode::Home),
        b'P' => Option::Some(KeyCode::F(1)),
        b'Q' => Option::Some(KeyCode::F(2)),
        b'S' => Option::Some(KeyCode::F(4)),
        _ => Option::None,
    }
}

// The key of an SS3 sequence's final byte: cursor keys in application mode,
// F1 to F4, and the keypad in application mode.
fn ss3_key(_ b: u8) -> Option<KeyCode> {
    if b >= b'j' && b <= b'y' {
        // `*`, `+`, `,`, `-`, `.`, `/` and `0` to `9`.
        return Option::Some(KeyCode::Char(b - 0x40))
    }
    match b {
        b'R' => Option::Some(KeyCode::F(3)),
        b'M' => Option::Some(KeyCode::Enter),
        b'I' => Option::Some(KeyCode::Tab),
        b' ' => Option::Some(KeyCode::Char(b' ')),
        b'X' => Option::Some(KeyCode::Char(b'=')),
        _ => letter_key(b),
    }
}

// The key of `CSI n ~`: the VT220 editing and function keys, with rxvt's
// Home and End, and kitty's Menu (29, which was F16) and keypad Begin.
fn tilde_key(_ n: u32) -> Option<KeyCode> {
    match n {
        1 => Option::Some(KeyCode::Home),
        2 => Option::Some(KeyCode::Insert),
        3 => Option::Some(KeyCode::Delete),
        4 => Option::Some(KeyCode::End),
        5 => Option::Some(KeyCode::PageUp),
        6 => Option::Some(KeyCode::PageDown),
        7 => Option::Some(KeyCode::Home),
        8 => Option::Some(KeyCode::End),
        11 => Option::Some(KeyCode::F(1)),
        12 => Option::Some(KeyCode::F(2)),
        13 => Option::Some(KeyCode::F(3)),
        14 => Option::Some(KeyCode::F(4)),
        15 => Option::Some(KeyCode::F(5)),
        17 => Option::Some(KeyCode::F(6)),
        18 => Option::Some(KeyCode::F(7)),
        19 => Option::Some(KeyCode::F(8)),
        20 => Option::Some(KeyCode::F(9)),
        21 => Option::Some(KeyCode::F(10)),
        23 => Option::Some(KeyCode::F(11)),
        24 => Option::Some(KeyCode::F(12)),
        25 => Option::Some(KeyCode::F(13)),
        26 => Option::Some(KeyCode::F(14)),
        28 => Option::Some(KeyCode::F(15)),
        29 => Option::Some(KeyCode::Menu),
        31 => Option::Some(KeyCode::F(17)),
        32 => Option::Some(KeyCode::F(18)),
        33 => Option::Some(KeyCode::F(19)),
        34 => Option::Some(KeyCode::F(20)),
        57427 => Option::Some(KeyCode::KeypadBegin),
        _ => Option::None,
    }
}

// The key of a kitty protocol key code: a Unicode scalar value, or one of
// the functional keys it places in the Private Use Area. Media keys and the
// ISO level shifts are dropped.
fn kitty_code(_ code: u32) -> Option<KeyCode> {
    match code {
        9 => {
            return Option::Some(KeyCode::Tab)
        },
        13 => {
            return Option::Some(KeyCode::Enter)
        },
        27 => {
            return Option::Some(KeyCode::Esc)
        },
        127 => {
            return Option::Some(KeyCode::Backspace)
        },
        57358 => {
            return Option::Some(KeyCode::CapsLock)
        },
        57359 => {
            return Option::Some(KeyCode::ScrollLock)
        },
        57360 => {
            return Option::Some(KeyCode::NumLock)
        },
        57361 => {
            return Option::Some(KeyCode::PrintScreen)
        },
        57362 => {
            return Option::Some(KeyCode::Pause)
        },
        57363 => {
            return Option::Some(KeyCode::Menu)
        },
        57409 => {
            return Option::Some(KeyCode::Char(b'.'))
        },
        57410 => {
            return Option::Some(KeyCode::Char(b'/'))
        },
        57411 => {
            return Option::Some(KeyCode::Char(b'*'))
        },
        57412 => {
            return Option::Some(KeyCode::Char(b'-'))
        },
        57413 => {
            return Option::Some(KeyCode::Char(b'+'))
        },
        57414 => {
            return Option::Some(KeyCode::Enter)
        },
        57415 => {
            return Option::Some(KeyCode::Char(b'='))
        },
        57416 => {
            return Option::Some(KeyCode::Char(b','))
        },
        57417 => {
            return Option::Some(KeyCode::Left)
        },
        57418 => {
            return Option::Some(KeyCode::Right)
        },
        57419 => {
            return Option::Some(KeyCode::Up)
        },
        57420 => {
            return Option::Some(KeyCode::Down)
        },
        57421 => {
            return Option::Some(KeyCode::PageUp)
        },
        57422 => {
            return Option::Some(KeyCode::PageDown)
        },
        57423 => {
            return Option::Some(KeyCode::Home)
        },
        57424 => {
            return Option::Some(KeyCode::End)
        },
        57425 => {
            return Option::Some(KeyCode::Insert)
        },
        57426 => {
            return Option::Some(KeyCode::Delete)
        },
        57427 => {
            return Option::Some(KeyCode::KeypadBegin)
        },
        _ => {},
    }
    if code >= 57376 && code <= 57398 {
        return Option::Some(KeyCode::F((code - 57376 + 13).downcast_truncate()))
    }
    if code >= 57399 && code <= 57408 {
        let digit: u8 = (code - 57399).downcast_truncate()
        return Option::Some(KeyCode::Char(b'0' + digit))
    }
    if code >= 57441 && code <= 57452 {
        // Left, then right: Shift, Control, Alt, Super, Hyper, Meta.
        let modifier = match (code - 57441) % 6 {
            0 => Modifiers::SHIFT,
            1 => Modifiers::CTRL,
            2 => Modifiers::ALT,
            3 => Modifiers::SUPER,
            4 => Modifiers::HYPER,
            _ => Modifiers::META,
        }
        return Option::Some(KeyCode::Modifier(modifier))
    }
    if code < 0x20
        || (code >= 0xd800 && code < 0xe000)
        || code > 0x10ffff
        || (code >= 57344 && code <= 57454) {
        return Option::None
    }
    Option::Some(KeyCode::from_scalar(code))
}

// The reply to `request_colors`: `10;rgb:R/G/B` or `11;rgb:R/G/B`, each
// component one to four hex digits.
fn default_color(_ text: MemSpan) -> Option<Reply> {
    if text.len() < 7 || text[0] != b'1' || text[2] != b';' {
        return Option::None
    }
    if text.slice(offset: 3, len: 4) != "rgb:" {
        return Option::None
    }
    var components: [u8; 3] = [0; 3]
    var pos: usize = 7
    var index: usize = 0
    while index < 3 {
        var value: u32 = 0
        var digits: u32 = 0
        while pos < text.len() && text[pos] != b'/' {
            let digit = hex_digit(text[pos])?
            if digits == 4 {
                return Option::None
            }
            value = value * 16 + digit
            digits += 1
            pos += 1
        }
        if digits == 0 || (index < 2) != (pos < text.len()) {
            return Option::None
        }
        // Scale to 8 bits: `f` is 255, `ffff` is 255, `8000` is 128.
        let max = (1 << (4 * digits)) - 1
        components[index] = ((value * 255 + max / 2) / max).downcast_truncate()
        pos += 1
        index += 1
    }
    match text[1] {
        b'0' => Option::Some(
            Reply::Foreground(components[0], components[1], components[2]),
        ),
        b'1' => Option::Some(
            Reply::Background(components[0], components[1], components[2]),
        ),
        _ => Option::None,
    }
}

fn hex_digit(_ b: u8) -> Option<u32> {
    if b >= b'0' && b <= b'9' {
        Option::Some((b - b'0') as u32)
    } else if b >= b'a' && b <= b'f' {
        Option::Some((b - b'a' + 10) as u32)
    } else if b >= b'A' && b <= b'F' {
        Option::Some((b - b'A' + 10) as u32)
    } else {
        Option::None
    }
}

/// Which mouse actions a terminal reports.
pub enum MouseTracking {
    /// Presses, releases and the wheel (mode 1000).
    Clicks,
    /// Those, and motion with a button held (mode 1002).
    Drags,
    /// Those, and all motion (mode 1003).
    Motion,
}

impl Copy for MouseTracking {}

fn push_csi(_ out: mut MemBuffer) {
    out.push(ESC)
    out.push(b'[')
}

fn private_mode(_ out: mut MemBuffer, _ mode: u16, set: bool) {
    push_csi(mut out)
    write!(mut out, "?", mode, if set { "h" } else { "l" })
}

/// Appends the sequences that turn on mouse reports of `tracking`, in the
/// SGR encoding (mode 1006), which the parser reads at any coordinate.
pub fn enable_mouse(_ out: mut MemBuffer, _ tracking: MouseTracking) {
    let mode: u16 = match tracking {
        MouseTracking::Clicks => 1000,
        MouseTracking::Drags => 1002,
        MouseTracking::Motion => 1003,
    }
    private_mode(mut out, mode, set: true)
    private_mode(mut out, 1006, set: true)
}

/// Appends the sequences that turn off every mouse mode `enable_mouse` can
/// turn on.
pub fn disable_mouse(_ out: mut MemBuffer) {
    private_mode(mut out, 1006, set: false)
    private_mode(mut out, 1003, set: false)
    private_mode(mut out, 1002, set: false)
    private_mode(mut out, 1000, set: false)
}

/// Appends the sequence that turns on bracketed paste (mode 2004), so a
/// paste arrives as one `Event::Paste` rather than as keys.
pub fn enable_bracketed_paste(_ out: mut MemBuffer) {
    private_mode(mut out, 2004, set: true)
}

/// Appends the sequence that turns off bracketed paste.
pub fn disable_bracketed_paste(_ out: mut MemBuffer) {
    private_mode(mut out, 2004, set: false)
}

/// Appends the sequence that turns on focus reports (mode 1004):
/// `Event::FocusGained` and `Event::FocusLost`.
pub fn enable_focus_events(_ out: mut MemBuffer) {
    private_mode(mut out, 1004, set: true)
}

/// Appends the sequence that turns off focus reports.
pub fn disable_focus_events(_ out: mut MemBuffer) {
    private_mode(mut out, 1004, set: false)
}

/// Appends the sequence that pushes `flags` on the kitty keyboard
/// protocol's stack (`CSI > flags u`). Terminals without the protocol
/// ignore it. `KeyboardFlags::DISAMBIGUATE` is what most programs want;
/// add `REPORT_EVENT_TYPES` for releases.
pub fn push_keyboard_flags(_ out: mut MemBuffer, _ flags: KeyboardFlags) {
    push_csi(mut out)
    write!(mut out, ">", flags.bits(), "u")
}

/// Appends the sequence that pops the flags `push_keyboard_flags` pushed
/// (`CSI < u`), restoring the terminal's earlier keyboard mode.
pub fn pop_keyboard_flags(_ out: mut MemBuffer) {
    push_csi(mut out)
    write!(mut out, "<u")
}

/// Appends the query for the kitty keyboard flags in effect (`CSI ? u`),
/// which a terminal with the protocol answers with `Reply::KeyboardFlags`.
/// Send `request_device_attributes` after it: its answer coming alone
/// means the terminal lacks the protocol.
pub fn request_keyboard_flags(_ out: mut MemBuffer) {
    push_csi(mut out)
    write!(mut out, "?u")
}

/// Appends the query for the primary device attributes (`CSI c`), which
/// every terminal answers with `Reply::DeviceAttributes`.
pub fn request_device_attributes(_ out: mut MemBuffer) {
    push_csi(mut out)
    out.push(b'c')
}

/// Appends the query for the setting of the private mode `mode`
/// (DECRQM, `CSI ? mode $ p`), answered with `Reply::Mode`; for instance
/// 2026, synchronized output.
pub fn request_mode(_ out: mut MemBuffer, _ mode: u16) {
    push_csi(mut out)
    write!(mut out, "?", mode, "$p")
}

/// Appends the queries for the default foreground and background colors
/// (OSC 10 and OSC 11), answered with `Reply::Foreground` and
/// `Reply::Background`, from which a program can tell a dark theme from a
/// light one.
pub fn request_colors(_ out: mut MemBuffer) {
    out.push(ESC)
    write!(mut out, "]10;?")
    out.push(ESC)
    write!(mut out, "\\")
    out.push(ESC)
    write!(mut out, "]11;?")
    out.push(ESC)
    write!(mut out, "\\")
}
