//! The drawing effect.
//!
//! A `Frame` is what view code draws into: it declares
//! `uses (frame: mut Frame)`, and widgets and the free functions of this
//! module draw through it. A frame owns the `Buffer` it draws into and
//! holds a clip rectangle, a theme and a cursor request.
//!
//! Every drawing call clips to the clip rectangle: a position or area
//! outside it draws nothing there, and nothing panics. Writing over half of
//! a wide symbol at the clip's edge turns its other half, outside the clip,
//! into a space, so the buffer keeps whole symbols.
//!
//! Scoped changes are projections used through `with`. `clipped(area)`
//! intersects the clip with `area`, and `themed(theme)` sets the theme,
//! until the `with` block ends:
//!
//! ```fe
//! fn view(_ area: Rect) uses (frame: mut Frame) {
//!     let (head, body) = area.rows((Length(1), Fill(1)))
//!     print(head.pos(), "Title", theme().title)
//!     with (Frame = clipped(body)) {
//!         with (Frame = themed(Theme::plain())) {
//!             print(body.pos(), "inside the body", Style::new())
//!         }
//!     }
//! }
//! ```
//!
//! The change is undone when the access ends: after the block's last use
//! of the frame, and on every path out of the block, including a `return`,
//! `break`, `continue` or failing `?` inside it. A panic aborts the
//! program, so nothing is undone then. `clipped` and `themed` take the
//! frame from the effect, so each nested `with` changes the innermost frame
//! and a nested clip never leaves its parent's.
//!
//! Inside such a block, draw through the free functions and widgets, which
//! take the innermost frame. The enclosing function's own binding names the
//! frame outside the block: `frame.print(..)` there ends the scoped access
//! early and draws unclipped, or is rejected if the block uses the scoped
//! frame after it.
use core::MemSpan
use core::mem::replace
use std::io::Display
use super::buffer::{Buffer, cell_at}
use super::geom::{Pos, Rect, Size}
use super::style::{Color, Modifier, Style}
use super::text::{
    Alignment,
    Line,
    Run,
    Lines,
    next_cluster,
    truncate,
    truncate_with_ellipsis,
    width,
}
use super::theme::Theme

/// The surface view code draws on: a buffer, the clip rectangle drawing
/// stays in, the theme widgets draw with, and where to show the cursor.
pub struct Frame {
    buffer: Buffer,
    clip: Rect,
    theme: Theme,
    // Text being drawn, formatted.
    scratch: MemBuffer,
    cursor: Option<Pos>,
}

impl Frame {
    /// A frame that draws over what `buffer` holds, clipped to the whole
    /// buffer, with `theme` and the cursor hidden. Clear the buffer first to
    /// draw a frame from nothing.
    pub fn new(_ buffer: own Buffer, _ theme: Theme) -> Self {
        let clip = buffer.area()
        Frame { buffer, clip, theme, scratch: MemBuffer::empty(), cursor: Option::None }
    }

    /// The buffer drawn into.
    pub fn into_buffer(own self) -> Buffer {
        self.buffer
    }

    /// The buffer drawn into. Drawing into it directly ignores the clip.
    pub fn buffer(mut? self) -> mut? Buffer {
        mut? self.buffer
    }

    /// The whole drawing area: the buffer's.
    pub fn area(self) -> Rect {
        self.buffer.area()
    }

    /// The rectangle drawing stays in.
    pub fn clip(self) -> Rect {
        self.clip
    }

    /// The theme widgets draw with.
    pub fn theme(self) -> Theme {
        self.theme
    }

    /// Where the cursor should be shown after this frame, or `None` to hide
    /// it.
    pub fn cursor(self) -> Option<Pos> {
        self.cursor
    }

    /// Asks for the cursor at `pos` after this frame. A position outside the
    /// clip hides it, as the widget asking is not shown there.
    pub fn set_cursor(mut self, _ pos: Pos) {
        self.cursor = if self.clip.contains(pos) {
            Option::Some(pos)
        } else {
            Option::None
        }
    }

    /// Asks for the cursor to be hidden after this frame, as it is unless
    /// `set_cursor` asks otherwise.
    pub fn hide_cursor(mut self) {
        self.cursor = Option::None
    }

    /// Draws the `Display` text of `text` from `pos` to the right, with
    /// `style` applied over the cells' styles, up to the clip's right edge.
    /// Returns the columns written; see `Buffer::set_string`.
    pub fn print<T: Display>(mut self, _ pos: Pos, _ text: T, _ style: Style) -> u16 {
        self.print_clipped(pos, text, style, self.clip)
    }

    /// Draws `text` from the top left of `area`, on its top row and within
    /// it, as `print` does.
    pub fn print_in<T: Display>(mut self, _ area: Rect, _ text: T, _ style: Style) -> u16 {
        let (row, _) = area.split_top(1)
        self.print_clipped(area.pos(), text, style, self.clip.intersect(row))
    }

    // Prints as `print` does, within `clip`.
    fn print_clipped<T: Display>(
        mut self,
        _ pos: Pos,
        _ text: T,
        _ style: Style,
        _ clip: Rect,
    ) -> u16 {
        if pos.y < clip.y || pos.y >= clip.bottom() || pos.x >= clip.right() {
            return 0
        }
        self.scratch.clear()
        text.fmt(mut self.scratch)
        self.buffer
            .draw(
                pos,
                self.scratch.span(),
                style,
                from: if pos.x > clip.x { pos.x } else { clip.x },
                to: clip.right(),
            )
    }

    /// Draws the first line of `text`, such as a `Line`, on the top row of
    /// `area`, each run in its style applied over the cells' styles, placed
    /// in the row by `alignment`. A line wider than the area is cut after
    /// its last whole cluster that fits, as `text::truncate` cuts it, so a
    /// wide cluster is never split: one that would cross the area's right
    /// edge leaves its column as it was. Returns the columns written.
    pub fn print_line<S: StyledText>(
        mut self,
        _ area: Rect,
        _ text: S,
        _ alignment: Alignment,
    ) -> u16 {
        self.print_line_cut(area, text, alignment, ellipsis: false)
    }

    /// Draws the first line of `text` as `print_line` does, except that a
    /// line wider than the area is cut as `text::truncate_with_ellipsis`
    /// cuts it and ends in `text::ELLIPSIS`, in the style of the text it
    /// stands for.
    pub fn print_line_with_ellipsis<S: StyledText>(
        mut self,
        _ area: Rect,
        _ text: S,
        _ alignment: Alignment,
    ) -> u16 {
        self.print_line_cut(area, text, alignment, ellipsis: true)
    }

    // Draws the first line of `text` as `print_line` does, or as
    // `print_line_with_ellipsis` does if `ellipsis`.
    pub(ingot) fn print_line_cut<S: StyledText>(
        mut self,
        _ area: Rect,
        _ text: S,
        _ alignment: Alignment,
        ellipsis: bool,
    ) -> u16 {
        if area.is_empty() || text.line_count() == 0 {
            return 0
        }
        let room = area.width as usize
        let bytes = text.line_text(0)
        let len = if ellipsis {
            truncate_with_ellipsis(bytes, room)
        } else {
            truncate(bytes, room)
        }
        let elide = ellipsis && len < bytes.len()
        let shown = width(bytes.slice(offset: 0, len))
        let lead = alignment.offset(
                width: if elide { shown + 1 } else { shown },
                available: room,
            )
        let x: u16 = (area.x as usize + lead).downcast_truncate()
        let (row, _) = area.split_top(1)
        var written = self
            .draw_styled(
                text,
                line: 0,
                start: 0,
                end: len,
                Pos::new(x, y: area.y),
                skip: 0,
                within: row,
            )
        let clip = self.clip.intersect(row)
        if elide && area.y >= clip.y && area.y < clip.bottom() {
            let at: u16 = (x as usize + shown).downcast_truncate()
            written += self.buffer
                .draw_ellipsis(
                    Pos::new(x: at, y: area.y),
                    style_at(text, line: 0, offset: len),
                    from: clip.x,
                    to: clip.right(),
                )
        }
        written
    }

    // Draws the bytes `start..end` of line `line` of `text`, which start
    // and end at clusters, on row `pos.y`: the column `skip` of the range
    // at `pos.x`, the columns before it hidden, and only in the clip and
    // `within`. Each run is drawn in its style over the cells' styles; a
    // cluster belongs to the run it starts in. A wide cluster that `skip`
    // cuts in half leaves a space in its style. Returns the columns
    // written.
    pub(ingot) fn draw_styled<S: StyledText>(
        mut self,
        _ text: S,
        line: usize,
        start: usize,
        end: usize,
        _ pos: Pos,
        skip: usize,
        within: Rect,
    ) -> u16 {
        let clip = self.clip.intersect(within)
        if pos.y < clip.y || pos.y >= clip.bottom() || pos.x >= clip.right() {
            return 0
        }
        let bytes = text.line_text(line)
        let from = if pos.x > clip.x { pos.x } else { clip.x }
        var written: u16 = 0
        var offset = start
        // The columns of the range before `offset`.
        var column: usize = 0
        while offset < end && column < skip {
            let cluster = next_cluster(bytes, offset)
            column += cluster.width as usize
            if column > skip && pos.x >= from {
                let style = style_at(text, line, offset)
                self.buffer
                    .fill(
                        Rect::new(x: pos.x, y: pos.y, width: 1, height: 1),
                        bytes.slice(offset: 0, len: 0),
                        style,
                    )
                written += 1
            }
            offset += cluster.len
        }
        if column < skip {
            return written
        }
        let to = clip.right() as usize
        var x = pos.x as usize + (column - skip)
        let runs = text.run_count(line)
        var run: usize = 0
        while offset < end && x < to {
            while run + 1 < runs && text.run(line, run).end <= offset {
                run += 1
            }
            // The last run takes any bytes after the runs.
            let (run_end, style) = if runs == 0 {
                (end, Style::NONE)
            } else {
                let current = text.run(line, run)
                (if run + 1 == runs { end } else { current.end }, current.style)
            }
            let segment = offset
            var columns: usize = 0
            while offset < end && offset < run_end {
                let cluster = next_cluster(bytes, offset)
                offset += cluster.len
                columns += cluster.width as usize
            }
            written += self.buffer
                .draw(
                    Pos::new(x: x.downcast_truncate(), y: pos.y),
                    bytes.slice(offset: segment, len: offset - segment),
                    style,
                    from,
                    to: clip.right(),
                )
            x += columns
        }
        written
    }

    // Intersects the clip with `area` until `restore_clip` restores the one
    // this returns. A widget that draws rows or cells by a closure clips the
    // closure's drawing this way, around each call:
    //
    //     let clip = frame.clip_to(row)
    //     draw(item, row)
    //     frame.restore_clip(clip)
    //
    // A `with (Frame = clipped(row)) { draw(item, row) }` there would not
    // clip, since a callable whose row the widget forwards (`uses F::E`)
    // draws into the frame the widget's caller provides (Fe issue
    // with-block-ignored-by-forwarded-row-call). A function that does the
    // three steps, `draw_clipped(row, item, row, draw)`, would be the safe
    // form; the compiler rejects its call when the closure comes from a
    // function that has the frame as an effect (Fe issue
    // own-effect-and-row-component-rejected).
    pub(ingot) fn clip_to(mut self, _ area: Rect) -> Rect {
        let old = self.clip
        self.clip = old.intersect(area)
        old
    }

    pub(ingot) fn restore_clip(mut self, _ clip: Rect) {
        self.clip = clip
    }

    /// The columns the `Display` text of `text` takes; see `text::width`.
    pub fn measure<T: Display>(mut self, _ text: T) -> usize {
        self.scratch.clear()
        text.fmt(mut self.scratch)
        width(self.scratch.span())
    }

    // The buffer the frame formats text into, for a widget that formats
    // text and draws it in parts: an empty buffer stands in for it until
    // `restore_scratch` gives it back, so its memory serves every frame.
    pub(ingot) fn take_scratch(mut self) -> MemBuffer {
        var scratch = replace(mut self.scratch, MemBuffer::empty())
        scratch.clear()
        scratch
    }

    pub(ingot) fn restore_scratch(mut self, _ scratch: own MemBuffer) {
        self.scratch = scratch
    }

    /// Writes the first grapheme cluster of the `Display` text of `symbol`
    /// into every cell of `area`; see `Buffer::fill`.
    pub fn fill<T: Display>(mut self, _ area: Rect, _ symbol: T, _ style: Style) {
        self.scratch.clear()
        symbol.fmt(mut self.scratch)
        self.buffer.fill(area.intersect(self.clip), self.scratch.span(), style)
    }

    /// Applies `style` over the style of each cell of `area`.
    pub fn set_style(mut self, _ area: Rect, _ style: Style) {
        self.buffer.set_style(area.intersect(self.clip), style)
    }

    /// Makes every cell of `area` empty: a space in the terminal's default
    /// colors.
    pub fn clear(mut self, _ area: Rect) {
        self.buffer.reset(area.intersect(self.clip))
    }
}

/// Styled text a frame draws: lines of bytes, each in runs of styles that
/// cover its bytes in order, the last run taking any bytes after the
/// others. `Line` is one line, `Lines` holds its lines, and bytes
/// (`MemSpan`) are one line in no style. Widgets such as `Paragraph` lay a
/// line out as `text::Wrap` reads it, so line breaks in a line's bytes end
/// its rows there.
pub trait StyledText {
    /// The number of lines.
    fn line_count(self) -> usize

    /// The bytes of line `line`, which is less than `line_count()`.
    fn line_text(self, _ line: usize) -> ref MemSpan

    /// The number of runs of line `line`.
    fn run_count(self, _ line: usize) -> usize

    /// The run `index` of line `line`, which is less than `run_count(line)`.
    fn run(self, _ line: usize, _ index: usize) -> Run
}

/// One line.
impl StyledText for Line {
    fn line_count(self) -> usize {
        1
    }

    fn line_text(self, _ line: usize) -> ref MemSpan {
        self.text()
    }

    fn run_count(self, _ line: usize) -> usize {
        self.run_count()
    }

    fn run(self, _ line: usize, _ index: usize) -> Run {
        self.run(index)
    }
}

/// Its lines, top to bottom.
impl StyledText for Lines {
    fn line_count(self) -> usize {
        self.height()
    }

    fn line_text(self, _ line: usize) -> ref MemSpan {
        self.lines()[line].text()
    }

    fn run_count(self, _ line: usize) -> usize {
        self.lines()[line].run_count()
    }

    fn run(self, _ line: usize, _ index: usize) -> Run {
        self.lines()[line].run(index)
    }
}

/// One line of the bytes in no style, or none if there are no bytes.
impl StyledText for MemSpan {
    fn line_count(self) -> usize {
        if self.is_empty() { 0 } else { 1 }
    }

    fn line_text(self, _ line: usize) -> ref MemSpan {
        self
    }

    fn run_count(self, _ line: usize) -> usize {
        1
    }

    fn run(self, _ line: usize, _ index: usize) -> Run {
        Run { start: 0, end: self.len(), style: Style::NONE }
    }
}

// The style of the run of line `line` of `text` that byte `offset` is in:
// the last run's for an offset after the runs.
fn style_at<S: StyledText>(_ text: S, line: usize, offset: usize) -> Style {
    let runs = text.run_count(line)
    var index: usize = 0
    while index + 1 < runs && text.run(line, index).end <= offset {
        index += 1
    }
    if runs == 0 {
        Style::NONE
    } else {
        text.run(line, index).style
    }
}

/// The frame, clipped to the part of its clip in `area` until the access
/// ends: `with (Frame = clipped(area)) { .. }`.
pub fn clipped(_ area: Rect) -> mut Frame uses (frame: mut Frame) {
    let old = frame.clip
    frame.clip = old.intersect(area)
    yield mut frame
    frame.clip = old
}

/// The frame, drawing with `theme` until the access ends:
/// `with (Frame = themed(theme)) { .. }`.
pub fn themed(_ theme: Theme) -> mut Frame uses (frame: mut Frame) {
    let old = frame.theme
    frame.theme = theme
    yield mut frame
    frame.theme = old
}

/// Draws the `Display` text of `text` from `pos`; see `Frame::print`.
pub fn print<T: Display>(_ pos: Pos, _ text: T, _ style: Style) -> u16
uses (frame: mut Frame)
{
    frame.print(pos, text, style)
}

/// Draws `text` on the top row of `area`; see `Frame::print_in`.
pub fn print_in<T: Display>(_ area: Rect, _ text: T, _ style: Style) -> u16
uses (frame: mut Frame)
{
    frame.print_in(area, text, style)
}

/// Draws the first line of `text` on the top row of `area`; see
/// `Frame::print_line`.
pub fn print_line<S: StyledText>(_ area: Rect, _ text: S, _ alignment: Alignment) -> u16
uses (frame: mut Frame)
{
    frame.print_line(area, text, alignment)
}

/// Draws the first line of `text` on the top row of `area`, with an
/// ellipsis if it is cut; see `Frame::print_line_with_ellipsis`.
pub fn print_line_with_ellipsis<S: StyledText>(
    _ area: Rect,
    _ text: S,
    _ alignment: Alignment,
) -> u16
uses (frame: mut Frame)
{
    frame.print_line_with_ellipsis(area, text, alignment)
}

/// Applies `style` over the style of each cell of `area`; see
/// `Frame::set_style`.
pub fn set_style(_ area: Rect, _ style: Style) uses (frame: mut Frame) {
    frame.set_style(area, style)
}

/// The columns the `Display` text of `text` takes; see `Frame::measure`.
pub fn measure<T: Display>(_ text: T) -> usize uses (frame: mut Frame) {
    frame.measure(text)
}

/// Fills `area` with `symbol`; see `Frame::fill`.
pub fn fill<T: Display>(_ area: Rect, _ symbol: T, _ style: Style)
uses (frame: mut Frame)
{
    frame.fill(area, symbol, style)
}

/// The whole drawing area.
pub fn area() -> Rect uses (frame: Frame) {
    frame.area()
}

/// The theme to draw with.
pub fn theme() -> Theme uses (frame: Frame) {
    frame.theme
}

/// For tests: a frame of `width` by `height` empty cells with the dark
/// theme.
pub(ingot) fn frame_of(width: u16, height: u16) -> Frame {
    Frame::new(Buffer::new(Size::new(width, height)), Theme::dark())
}

/// For tests: the buffer `draw` leaves in a frame of `width` by `height`
/// empty cells with the dark theme. `draw` gets the frame, to provide to
/// what it draws, and the frame's area:
///
/// ```fe
/// #[test]
/// fn borders_fill_the_frame() {
///     let text = drawn(width: 5, height: 3, |frame, area| {
///         with (frame) { Block::bordered().render(area) }
///     }).to_text()
///     assert(text == "┌───┐\n│   │\n└───┘")
/// }
/// ```
pub(ingot) fn drawn<F: Fn(mut Frame, Rect)>(width: u16, height: u16, _ draw: F) -> Buffer
uses F::E
{
    var frame = frame_of(width, height)
    let area = frame.area()
    draw(mut frame, area)
    frame.into_buffer()
}

/// For tests: the text of the buffer `drawn` gives, row by row; see
/// `Buffer::to_text`.
pub(ingot) fn drawn_text<F: Fn(mut Frame, Rect)>(width: u16, height: u16, _ draw: F) -> MemBuffer
uses F::E
{
    drawn(width, height, draw).to_text()
}

fn clip() -> Rect uses (frame: Frame) {
    frame.clip
}

#[test]
fn prints_clip_to_the_clip() {
    var frame = frame_of(width: 8, height: 3)
    assert(
        frame.print(Pos::new(x: 6, y: 0), "abc", Style::new()) == 2,
    )
    assert(
        frame.print(Pos::new(x: 0, y: 1), 4207 as u16, Style::new()) == 4,
    )
    assert(frame.print(Pos::new(x: 0, y: 3), "x", Style::new()) == 0)
    assert(frame.print(Pos::new(x: 8, y: 2), "x", Style::new()) == 0)
    assert(frame.into_buffer().to_text() == "      ab\n4207\n")
}

#[test]
fn prints_in_an_area_keep_to_its_top_row() {
    var frame = frame_of(width: 8, height: 3)
    assert(
        frame.print_in(
                    Rect::new(x: 2, y: 1, width: 3, height: 2),
                    "hello",
                    Style::new(),
                ) == 3,
    )
    assert(
        frame.print_in(
                    Rect::new(x: 0, y: 0, width: 0, height: 2),
                    "hello",
                    Style::new(),
                ) == 0,
    )
    assert(
        frame.print_in(
                    Rect::new(x: 6, y: 2, width: 9, height: 9),
                    "hello",
                    Style::new(),
                ) == 2,
    )
    assert(
        frame.print_in(
                    Rect::new(x: 9, y: 9, width: 9, height: 9),
                    "hello",
                    Style::new(),
                ) == 0,
    )
    assert(frame.buffer().to_text() == "\n  hel\n      he")
}

fn draw_in_clip() uses (frame: mut Frame) {
    with (Frame = clipped(Rect::new(x: 2, y: 0, width: 3, height: 2))) {
        // Starts left of the clip: only the columns in it are drawn.
        print(Pos::new(x: 0, y: 0), "abcdefg", Style::new())
        fill(
            Rect::new(x: 0, y: 1, width: 9, height: 9),
            "#",
            Style::new(),
        )
        embolden()
    }
}

// Naming `frame` inside the `with` above would reach the unclipped frame; a
// callee's `frame` is the innermost one.
fn embolden() uses (frame: mut Frame) {
    frame.set_style(frame.area(), Style::new().bold())
}

#[test]
fn drawing_stays_in_the_clip() {
    var frame = frame_of(width: 6, height: 3)
    frame.fill(frame.area(), ".", Style::new())
    with (frame) {
        draw_in_clip()
    }
    assert(frame.clip() == frame.area())
    assert(frame.buffer().to_text() == "..cde.\n..###.\n......")
    let buffer = ref frame.buffer()
    assert(
        buffer.get(Pos::new(x: 2, y: 0)).unwrap().modifier() == Modifier::BOLD,
    )
    assert(
        buffer.get(Pos::new(x: 1, y: 0)).unwrap().modifier().is_empty(),
    )
    frame.clear(Rect::new(x: 4, y: 0, width: 9, height: 2))
    assert(frame.buffer().to_text() == "..cd\n..##\n......")
}

// Calls `draw` for each of `items` on a row of `area`, clipped to the row,
// as a widget with a row closure does.
fn rows_with<F: Fn(u8, Rect)>(_ area: Rect, _ items: [u8; 3], _ draw: F)
uses (frame: mut Frame, F::E)
{
    for (i, item) in items.enumerate() {
        let row = Rect {
            x: area.x,
            y: area.y + i.downcast_truncate(),
            width: area.width,
            height: 1,
        }
        let clip = frame.clip_to(row)
        draw(item, row)
        frame.restore_clip(clip)
    }
}

#[test]
fn closures_draw_only_in_the_clip_around_their_call() {
    var frame = frame_of(width: 5, height: 4)
    frame.fill(frame.area(), ".", Style::new())
    with (frame) {
        rows_with(
            Rect::new(x: 1, y: 1, width: 3, height: 3),
            [1, 2, 3],
            |item, row| {
                // From the frame's left edge past the row's right one, and
                // over the whole top row.
                print(
                    Pos::new(x: 0, y: row.y),
                    format!(item, item, item, item, item),
                    Style::new(),
                )
                fill(
                    Rect::new(x: 0, y: 0, width: 5, height: 1),
                    "#",
                    Style::new(),
                )
            },
        )
    }
    assert(frame.clip() == frame.area())
    assert(frame.buffer().to_text() == ".....\n.111.\n.222.\n.333.")
}

fn nested() -> bool uses (frame: mut Frame) {
    var ok = true
    let outer = Rect::new(x: 1, y: 1, width: 6, height: 4)
    with (Frame = clipped(outer)) {
        ok = ok && clip() == outer
        with (Frame = themed(Theme::plain())) {
            ok = ok && theme().accent == Theme::plain().accent
            with (Frame = clipped(Rect::new(x: 0, y: 0, width: 3, height: 3))) {
                // A nested clip stays in its parent's.
                ok = ok && clip() == Rect::new(x: 1, y: 1, width: 2, height: 2)
                print(Pos::new(x: 0, y: 1), "xyz", Style::new())
            }
            ok = ok && clip() == outer && theme().accent == Theme::plain().accent
            print(Pos::new(x: 5, y: 4), "uvw", Style::new())
        }
        ok = ok && theme().accent == Theme::dark().accent && clip() == outer
        print(Pos::new(x: 0, y: 2), "<>", Style::new())
    }
    ok && clip() == area()
}

#[test]
fn scopes_nest_and_restore_in_order() {
    var frame = frame_of(width: 8, height: 6)
    var ok = false
    with (frame) {
        ok = nested()
    }
    assert(ok)
    assert(frame.buffer().to_text() == "\n yz\n >\n\n     uv\n")
}

fn leave_early(_ how: u8) -> Option<u8> uses (frame: mut Frame) {
    for i in 0 .. 3 {
        with (Frame = clipped(Rect::new(x: 1, y: 1, width: 1, height: 1))) {
            with (Frame = themed(Theme::plain())) {
                if how == 0 {
                    return Option::Some(0)
                }
                if how == 1 { break }
                if how == 2 && i < 2 {
                    continue
                }
                let none: Option<u8> = Option::None
                if how == 3 { none? }
                print(Pos::new(x: 1, y: 1), i, Style::new())
            }
        }
    }
    Option::Some(how)
}

#[test]
fn scopes_restore_on_every_way_out() {
    var frame = frame_of(width: 3, height: 3)
    for how in [0, 1, 2, 3, 4] {
        with (frame) {
            leave_early(how)
        }
        assert(frame.clip() == frame.area())
        assert(frame.theme().accent == Theme::dark().accent)
    }
    assert(frame.buffer().to_text() == "\n 2\n")
}

#[test]
fn display_text_measures_in_columns() {
    var frame = frame_of(width: 1, height: 1)
    assert(frame.measure("abc") == 3 && frame.measure("漢字") == 4)
    assert(frame.measure(1234 as u32) == 4 && frame.measure("") == 0)
}

#[test]
fn the_cursor_shows_only_in_the_clip() {
    var frame = frame_of(width: 4, height: 4)
    assert(frame.cursor().is_none())
    frame.set_cursor(Pos::new(x: 3, y: 3))
    assert(frame.cursor() == Option::Some(Pos::new(x: 3, y: 3)))
    frame.set_cursor(Pos::new(x: 4, y: 0))
    assert(frame.cursor().is_none())
    frame.set_cursor(Pos::new(x: 0, y: 0))
    frame.hide_cursor()
    assert(frame.cursor().is_none())
}

#[test]
fn empty_frames_draw_nothing() {
    var frame = frame_of(width: 0, height: 0)
    assert(frame.print(Pos::new(x: 0, y: 0), "x", Style::new()) == 0)
    frame.fill(
            Rect::new(x: 0, y: 0, width: 5, height: 5),
            "x",
            Style::new(),
        )
    frame.set_style(
            Rect::new(x: 0, y: 0, width: 5, height: 5),
            Style::new().bold(),
        )
    frame.clear(Rect::new(x: 0, y: 0, width: 5, height: 5))
    assert(frame.into_buffer().to_text().is_empty())
}

fn two_runs() -> Line {
    var line = Line::styled("ab", Style::new().fg(Color::RED))
    line.push("cdef", Style::new().fg(Color::BLUE))
    line
}

#[test]
fn lines_draw_each_run_in_its_style() {
    var frame = frame_of(width: 8, height: 2)
    let line = two_runs()
    // The first run ends inside the area, the second is cut.
    assert(
        frame.print_line(
                    Rect::new(x: 1, y: 0, width: 4, height: 2),
                    line,
                    Alignment::Left,
                ) == 4,
    )
    assert(frame.buffer().to_text() == " abcd\n")
    assert(cell_at(frame.buffer(), x: 0, y: 0).fg() == Color::RESET)
    assert(
        cell_at(frame.buffer(), x: 1, y: 0).fg() == Color::RED
            && cell_at(frame.buffer(), x: 2, y: 0).fg() == Color::RED,
    )
    assert(
        cell_at(frame.buffer(), x: 3, y: 0).fg() == Color::BLUE
            && cell_at(frame.buffer(), x: 4, y: 0).fg() == Color::BLUE,
    )
    assert(cell_at(frame.buffer(), x: 5, y: 0).fg() == Color::RESET)
}

#[test]
fn lines_align_in_their_area() {
    var frame = frame_of(width: 7, height: 3)
    let line = Line::from("ab")
    frame.print_line(
            Rect::new(x: 0, y: 0, width: 7, height: 1),
            line,
            Alignment::Left,
        )
    frame.print_line(
            Rect::new(x: 0, y: 1, width: 7, height: 1),
            line,
            Alignment::Center,
        )
    frame.print_line(
            Rect::new(x: 0, y: 2, width: 7, height: 1),
            line,
            Alignment::Right,
        )
    assert(frame.buffer().to_text() == "ab\n  ab\n     ab")
}

#[test]
fn lines_never_split_a_wide_cluster() {
    var frame = frame_of(width: 4, height: 3)
    frame.fill(frame.area(), ".", Style::new())
    var line = Line::styled("a", Style::new().fg(Color::RED))
    line.push("漢字", Style::new().fg(Color::BLUE))
    // "a漢" fits in 4 columns, "字" would cross the edge: its column stays.
    assert(
        frame.print_line(
                    Rect::new(x: 0, y: 0, width: 4, height: 1),
                    line,
                    Alignment::Left,
                ) == 3,
    )
    // Cut content aligns by the columns it takes.
    assert(
        frame.print_line(
                    Rect::new(x: 0, y: 1, width: 4, height: 1),
                    line,
                    Alignment::Right,
                ) == 3,
    )
    assert(
        frame
                .print_line(
                    Rect::new(x: 0, y: 2, width: 1, height: 1),
                    Line::from("漢"),
                    Alignment::Left,
                )
            == 0,
    )
    assert(frame.buffer().to_text() == "a漢.\n.a漢\n....")
    assert(
        cell_at(frame.buffer(), x: 1, y: 0).fg() == Color::BLUE
            && cell_at(frame.buffer(), x: 2, y: 0).fg() == Color::BLUE,
    )
}

#[test]
fn cut_lines_may_end_in_an_ellipsis() {
    var frame = frame_of(width: 6, height: 4)
    var line = Line::styled("abc", Style::new().fg(Color::RED))
    line.push("def", Style::new().fg(Color::BLUE))
    assert(
        frame
                .print_line_with_ellipsis(
                    Rect::new(x: 0, y: 0, width: 4, height: 1),
                    line,
                    Alignment::Left,
                )
            == 4,
    )
    // The ellipsis takes the style of the text it stands for.
    assert(
        cell_at(frame.buffer(), x: 2, y: 0).fg() == Color::RED
            && cell_at(frame.buffer(), x: 3, y: 0).fg() == Color::BLUE,
    )
    // A line that fits has none.
    assert(
        frame
                .print_line_with_ellipsis(
                    Rect::new(x: 0, y: 1, width: 6, height: 1),
                    line,
                    Alignment::Right,
                )
            == 6,
    )
    // A wide cluster that leaves no column for the ellipsis is left out.
    assert(
        frame
                .print_line_with_ellipsis(
                    Rect::new(x: 0, y: 2, width: 3, height: 1),
                    Line::from("漢字"),
                    Alignment::Left,
                )
            == 3,
    )
    assert(
        frame
                .print_line_with_ellipsis(
                    Rect::new(x: 0, y: 3, width: 2, height: 1),
                    Line::from("漢字"),
                    Alignment::Right,
                )
            == 1,
    )
    assert(frame.buffer().to_text() == "abc…\nabcdef\n漢…\n …")
}

#[test]
fn lines_may_be_bytes_or_the_first_line_of_a_text() {
    var frame = frame_of(width: 5, height: 3)
    let bytes = format!("abcdefg")
    let text = Lines::from("first\nsecond")
    assert(
        frame
                .print_line_with_ellipsis(
                    Rect::new(x: 0, y: 0, width: 5, height: 1),
                    bytes.span(),
                    Alignment::Left,
                )
            == 5,
    )
    frame.print_line(
            Rect::new(x: 0, y: 1, width: 5, height: 1),
            text,
            Alignment::Right,
        )
    // Empty bytes are no line.
    assert(
        frame
                .print_line(
                    Rect::new(x: 0, y: 2, width: 5, height: 1),
                    bytes.slice(offset: 0, len: 0),
                    Alignment::Left,
                )
            == 0,
    )
    assert(frame.buffer().to_text() == "abcd…\nfirst\n")
}

#[test]
fn clusters_take_the_style_of_the_run_they_start_in() {
    var frame = frame_of(width: 4, height: 1)
    // An "e" and a combining acute accent, in two runs: one cluster.
    var line = Line::styled("xe", Style::new().fg(Color::RED))
    line.push("́y", Style::new().fg(Color::BLUE))
    assert(line.width() == 3)
    assert(frame.print_line(frame.area(), line, Alignment::Left) == 3)
    assert(frame.buffer().to_text() == "xéy")
    assert(
        cell_at(frame.buffer(), x: 1, y: 0).fg() == Color::RED
            && cell_at(frame.buffer(), x: 2, y: 0).fg() == Color::BLUE,
    )
}

fn styled_rows() uses (frame: mut Frame) {
    let line = two_runs()
    with (Frame = clipped(Rect::new(x: 1, y: 0, width: 3, height: 1))) {
        print_line(
            Rect::new(x: 0, y: 0, width: 6, height: 2),
            line,
            Alignment::Left,
        )
        print_line_with_ellipsis(
            Rect::new(x: 0, y: 1, width: 6, height: 1),
            line,
            Alignment::Left,
        )
    }
    print_line_with_ellipsis(
        Rect::new(x: 0, y: 1, width: 0, height: 1),
        line,
        Alignment::Left,
    )
    print_line(
        Rect::new(x: 0, y: 1, width: 3, height: 0),
        line,
        Alignment::Left,
    )
}

#[test]
fn lines_stay_in_the_clip_and_their_area() {
    var frame = frame_of(width: 6, height: 2)
    with (frame) {
        styled_rows()
    }
    assert(frame.buffer().to_text() == " bcd\n")
    let empty = Line::new()
    assert(
        frame.print_line(frame.area(), empty, Alignment::Center) == 0,
    )
}

#[test]
fn skipped_columns_hide_the_start_of_a_range() {
    var frame = frame_of(width: 6, height: 3)
    var line = Line::styled("漢", Style::new().fg(Color::RED))
    line.push("字ab", Style::new().fg(Color::BLUE))
    let row = frame.area()
    // Column 1 cuts "漢" in half: a space in its style stands for it.
    assert(
        frame
                .draw_styled(
                    line,
                    line: 0,
                    start: 0,
                    end: line.len(),
                    Pos::new(x: 0, y: 0),
                    skip: 1,
                    within: row,
                )
            == 5,
    )
    assert(
        cell_at(frame.buffer(), x: 0, y: 0).fg() == Color::RED
            && cell_at(frame.buffer(), x: 1, y: 0).fg() == Color::BLUE,
    )
    assert(
        frame
                .draw_styled(
                    line,
                    line: 0,
                    start: 0,
                    end: line.len(),
                    Pos::new(x: 1, y: 1),
                    skip: 2,
                    within: row,
                )
            == 4,
    )
    // A range of the bytes: "字a".
    assert(
        frame
                .draw_styled(
                    line,
                    line: 0,
                    start: 3,
                    end: 7,
                    Pos::new(x: 0, y: 2),
                    skip: 0,
                    within: row,
                )
            == 3,
    )
    assert(frame.buffer().to_text() == " 字ab\n 字ab\n字a")
}
